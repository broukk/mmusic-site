    document.getElementById("statTotalPlays").textContent = realStats.totalPlays;
    document.getElementById("statUniqueTracks").textContent = realStats.uniqueTrackIds.length;
    document.getElementById("statTotalHours").textContent = (realStats.totalSeconds / 3600).toFixed(1);
    document.getElementById("profileStatPreview").textContent = `${realStats.totalPlays} просл.`;

    const daysCount = realStats.daysActive.length;
    document.getElementById("statStreakDays").textContent = daysCount;
    document.getElementById("statTracksPerDay").textContent = daysCount > 0 ? Math.round(realStats.totalPlays / daysCount) : 0;
    document.getElementById("statTotalArtists").textContent = Object.keys(realStats.artistsSeconds).length;

    const topHourEntry = Object.entries(realStats.hoursMap).sort((a, b) => b[1] - a[1])[0];
    document.getElementById("statPeakHour").textContent = topHourEntry ? topHourEntry[0] : "—";

    const topWeekdayEntry = Object.entries(realStats.weekdaysMap).sort((a, b) => b[1] - a[1])[0];
    document.getElementById("statFavWeekday").textContent = topWeekdayEntry ? topWeekdayEntry[0] : "—";

    const sortedArtists = Object.entries(realStats.artistsSeconds).sort((a, b) => b[1] - a[1]);
    const artistsContainer = document.getElementById("statsTopArtistsRow");
    if (!sortedArtists.length) {
      artistsContainer.innerHTML = `<div style="color:#8e8e93;font-size:13px;padding:8px 0">Пока нет прослушанных артистов</div>`;
    } else {
      artistsContainer.innerHTML = sortedArtists.map(([name, secs]) => {
        const mins = Math.max(1, Math.round(secs / 60));
        const cov = realStats.artistCovers[name] || DEFAULT_COVER_SVG;
        return `
          <div class="stat-artist-item" onclick="quickSearchArtist('${escapeHtml(name)}')">
            <img src="${cov}" alt="" onerror="this.onerror=null;this.src=DEFAULT_COVER_SVG">
            <div class="stat-artist-name">${escapeHtml(name)}</div>
            <div class="stat-artist-time">${mins} мин</div>
          </div>
        `;
      }).join("");
    }

    const sortedTrackEntries = Object.entries(realStats.trackPlaysMap).sort((a, b) => b[1] - a[1]);
    const tracksContainer = document.getElementById("statsTopTracksList");
    if (!sortedTrackEntries.length) {
      tracksContainer.innerHTML = `<div style="color:#8e8e93;font-size:13px;padding:8px 0">Включите любой трек для учёта в статистике</div>`;
    } else {
      tracksContainer.innerHTML = sortedTrackEntries.slice(0, 10).map(([id, count], idx) => {
        const t = knownTracksMap.get(id);
        if (!t) return "";
        return `
          <div class="clean-track-row" onclick="playSpecificTrack('${escapeHtml(t.id)}')">
            <span style="width:22px;font-size:14px;font-weight:700;color:#8e8e93">${idx + 1}</span>
            <img class="clean-track-cover" style="width:46px;height:46px" src="${t.cover || DEFAULT_COVER_SVG}" alt="" onerror="this.onerror=null;this.src=DEFAULT_COVER_SVG">
            <div class="clean-track-info">
              <div class="clean-track-title">${escapeHtml(t.title)}</div>
              <div class="clean-track-artist">${escapeHtml(t.artist)}</div>
            </div>
            <span style="font-size:13px;font-weight:700;color:#8e8e93;padding-right:8px">${count}</span>
          </div>
        `;
      }).join("");
    }
  }

  function renderAllViews() {
    bindCoverImage(document.getElementById("heroMainArt"), displayTracks[0]?.cover);
