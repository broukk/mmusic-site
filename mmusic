<!-- ==========================================================================
     1. ЭКРАН РЕГИСТРАЦИИ И ВХОДА ПО ЛОГИНУ И ПАРОЛЮ
     ========================================================================== -->
<div id="authOverlay" class="auth-overlay hidden">

  <div id="authStepWelcome" class="auth-step active">
    <div></div>
    <div class="welcome-center">
      <div class="book-circle-emblem">
        <svg class="welcome-book-svg" viewBox="0 0 34 26">
          <path class="wb-cover" d="M3 20 C9 18, 14 19, 17 21 C20 19, 25 18, 31 20" />
          <path class="wb-page" d="M4 6 C9 5, 14 6, 17 8 L17 20 C14 18, 9 17, 4 18 Z" />
          <path class="wb-page" d="M30 6 C25 5, 20 6, 17 8 L17 20 C20 18, 25 17, 30 18 Z" />
          <path class="wb-leaf" d="M29 5 C24 4, 20 5, 17 8 L17 19 C20 16, 24 15, 29 16 Z" />
        </svg>
      </div>
      <h1 style="font-size:40px;font-weight:800;letter-spacing:-0.8px;margin-bottom:8px">mmusic</h1>
      <p style="font-size:15px;color:#8e8e93">Вход и регистрация по логину и паролю</p>
    </div>

    <div style="display:flex;flex-direction:column;gap:10px">
      <button class="btn-white-pill" onclick="openCredentialsAuthFlow('login')">Войти в аккаунт</button>
      <button class="btn-dark-pill" onclick="openCredentialsAuthFlow('register')">Создать аккаунт</button>
    </div>
  </div>

  <div id="authStepCredentials" class="auth-step">
    <div style="display:flex;align-items:center;justify-content:space-between">
      <button class="lib-circle-btn" onclick="goToAuthStep('welcome')"><span class="icon">arrow_back</span></button>
      <span id="authStepCredentialsHeader" style="font-size:14px;font-weight:600;color:#8e8e93">Вход в аккаунт</span>
      <div style="width:44px"></div>
    </div>

    <div style="margin:auto 0;text-align:center">
      <div id="authMd3Avatar" class="md3-user-avatar style-red">
        <span id="authMd3AvatarIcon" class="icon filled" style="font-size:40px">graphic_eq</span>
      </div>

      <div id="avatarSelectBlock" style="display:none">
        <div style="font-size:12px;color:#8e8e93;margin-top:10px">Выберите иконку в стиле MD3:</div>
        <div class="avatar-style-selector">
          <button type="button" class="avatar-style-pill active" onclick="setAvatarStyle('style-red', 'graphic_eq', this)">Красная</button>
          <button type="button" class="avatar-style-pill" onclick="setAvatarStyle('style-black', 'album', this)">Чёрная</button>
          <button type="button" class="avatar-style-pill" onclick="setAvatarStyle('style-song', 'auto_awesome', this)">По цвету песни</button>
          <button type="button" class="avatar-style-pill" onclick="setAvatarStyle('style-green', 'equalizer', this)">Зелёная</button>
          <button type="button" class="avatar-style-pill" onclick="setAvatarStyle('style-violet', 'headphones', this)">Фиолетовая</button>
        </div>
      </div>

      <div id="nameInputBoxWrap" class="auth-input-box" style="display:none;margin-top:14px">
        <span class="icon" style="color:#8e8e93">badge</span>
        <input type="text" id="authDisplayNameInput" maxlength="40" autocomplete="name" placeholder="Отображаемое имя (до 40 символов)">
      </div>

      <div class="auth-input-box" style="margin-top:12px">
        <span class="icon" style="color:#8e8e93">alternate_email</span>
        <input type="text" id="authUsernameInput" maxlength="24" autocomplete="username" spellcheck="false" autocapitalize="none" placeholder="Логин (например, alex_01)" onkeydown="if(event.key==='Enter')submitCredentialsAuth()">
      </div>
      <div class="field-hint">Допустимо 3–24 символа: латинские буквы (a–z), цифры (0–9), символы «_» и «-». Регистр при проверке уникальности не учитывается.</div>

      <div class="auth-input-box">
        <span class="icon" style="color:#8e8e93">lock</span>
        <input type="password" id="authPasswordInput" autocomplete="current-password" placeholder="Пароль (не менее 8 символов)" onkeydown="if(event.key==='Enter')submitCredentialsAuth()">
        <button type="button" class="input-eye-btn" onclick="togglePasswordVisibility('authPasswordInput', 'authPassEyeIcon')" aria-label="Показать пароль">
          <span id="authPassEyeIcon" class="icon" style="font-size:20px">visibility</span>
        </button>
      </div>

      <div id="confirmPasswordWrap" style="display:none">
        <div class="auth-input-box">
          <span class="icon" style="color:#8e8e93">lock_reset</span>
          <input type="password" id="authPasswordConfirmInput" autocomplete="new-password" placeholder="Повторите пароль" onkeydown="if(event.key==='Enter')submitCredentialsAuth()">
        </div>
        <div class="field-hint">Пароль сохраняется в точности как введён (пробелы и регистр символов не изменяются).</div>
      </div>

      <div id="credentialsStepError" style="color:#ff6b6b;font-size:13px;margin-top:8px;display:none;line-height:1.4"></div>
    </div>

    <div style="display:flex;flex-direction:column;gap:10px">
      <button id="submitCredentialsBtn" class="btn-white-pill" onclick="submitCredentialsAuth()">Войти</button>
      <button id="toggleAuthModeBtn" class="btn-dark-pill" onclick="toggleBetweenLoginAndRegister()">Создать новый аккаунт</button>
    </div>
  </div>
</div>

