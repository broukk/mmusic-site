  function refreshCatalogStreams() {
    fetchTracksFromCatalog(lastSearchQuery || "Три дня дождя", false);
  }

  function extractColorFromCover(coverUrl) {
    if (!dynamicColorBySong || !coverUrl || coverUrl.startsWith("data:")) return;
    const img = new Image();
    img.crossOrigin = "Anonymous";
    img.onload = () => {
      try {
        const canvas = document.getElementById("colorCanvas");
        const ctx = canvas.getContext("2d");
        ctx.drawImage(img, 0, 0, 16, 16);
        const data = ctx.getImageData(0, 0, 16, 16).data;
        let r = 0, g = 0, b = 0, count = 0;
        for (let i = 0; i < data.length; i += 4) {
          const br = (data[i] + data[i + 1] + data[i + 2]) / 3;
          if (br > 25 && br < 230) { r += data[i]; g += data[i + 1]; b += data[i + 2]; count++; }
        }
        if (count > 0) {
          const hsl = rgbToHsl(r / count, g / count, b / count);
          document.documentElement.style.setProperty("--seed-h", Math.round(hsl.h));
          document.documentElement.style.setProperty("--seed-s", `${Math.max(50, Math.min(85, Math.round(hsl.s)))}%`);
        }
      } catch (_) {}
    };
    img.src = coverUrl;
  }

  function rgbToHsl(r, g, b) {
    r /= 255; g /= 255; b /= 255;
    const max = Math.max(r, g, b), min = Math.min(r, g, b);
    let h = 0, s = 0, l = (max + min) / 2;
    if (max !== min) {
      const d = max - min;
      s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
      switch (max) {
        case r: h = (g - b) / d + (g < b ? 6 : 0); break;
        case g: h = (b - r) / d + 2; break;
        case b: h = (r - g) / d + 4; break;
      }
      h /= 6;
    }
    return { h: h * 360, s: s * 100, l: l * 100 };
  }

  function toggleDynamicSongColor() {
    dynamicColorBySong = !dynamicColorBySong;
    document.getElementById("dynColorSwitch").classList.toggle("on", dynamicColorBySong);
    document.getElementById("potokModeText").textContent = dynamicColorBySong ? "Оттенок по песне" : "Обычная";
    const cur = currentQueue[currentIndex];
    if (dynamicColorBySong && cur) extractColorFromCover(cur.cover);
    saveRealStats();
  }

  function toggleAmoledMode() {
    const root = document.documentElement;
    const isAmoled = root.getAttribute("data-amoled") === "true";
    if (isAmoled) root.removeAttribute("data-amoled");
    else root.setAttribute("data-amoled", "true");
    document.getElementById("amoledSwitch").classList.toggle("on", !isAmoled);
    saveRealStats();
  }

  function syncPlayerUI() {
    const cur = currentQueue[currentIndex];
    document.getElementById("potokHeroPlayIcon").textContent = isPlayingState ? "pause" : "play_arrow";
    document.getElementById("miniPlayIcon").textContent = isPlayingState ? "pause" : "play_arrow";
    document.getElementById("fpPlayIcon").textContent = isPlayingState ? "pause" : "play_arrow";

    if (!cur) return;
    bindCoverImage(document.getElementById("miniCover"), cur.cover);
    bindCoverImage(document.getElementById("fpCover"), cur.cover);
    document.getElementById("miniTitle").textContent = cur.title;
    document.getElementById("miniArtist").textContent = cur.artist;
    document.getElementById("fpTitle").textContent = cur.title;
    document.getElementById("fpArtist").textContent = cur.artist;

    const isFav = favoriteIds.has(cur.id);
    const favIcon = document.getElementById("fpFavIcon");
    favIcon.classList.toggle("filled", isFav);
    favIcon.style.color = isFav ? "#ff6b6b" : "#ffffff";
  }

  function toggleFavCurrent() {
    const cur = currentQueue[currentIndex];
    if (!cur) return;
    if (favoriteIds.has(cur.id)) favoriteIds.delete(cur.id);
    else favoriteIds.add(cur.id);
    saveRealStats();
    syncPlayerUI();
    renderAllViews();
  }

  function toggleShuffle() {
    isShuffle = !isShuffle;
    document.getElementById("shuffleBtn").style.color = isShuffle ? "var(--md-primary)" : "#ffffff";
  }

  function toggleRepeat() {
    isRepeat = !isRepeat;
    audio.loop = isRepeat;
    document.getElementById("repeatBtn").style.color = isRepeat ? "var(--md-primary)" : "#ffffff";
  }

  function toggleFullPlayer(exp) {
    document.getElementById("fullPlayer").classList.toggle("expanded", exp);
  }

  function switchTab(tabName) {
    document.querySelectorAll(".screen").forEach((s) => s.classList.remove("active"));
    const target = document.getElementById(`tab-${tabName}`);
    if (target) target.classList.add("active");

    document.querySelectorAll(".nav-btn").forEach((b) => {
      b.classList.remove("active");
      b.querySelector(".icon").classList.remove("filled");
    });
    const navBtn = document.getElementById(`nav-${tabName === "stats" ? "profile" : (tabName === "fav-detail" ? "library" : tabName)}`);
    if (navBtn) {
      navBtn.classList.add("active");
      navBtn.querySelector(".icon").classList.add("filled");
    }
    if (tabName === "search") renderSearchResults(displayTracks);
    if (tabName === "profile") loadSessionsAndHistory();
  }

  function shareProfileStats() {
    const uid = currentUser ? (currentUser.publicId || currentUser.uid) : "Гость";
    const uname = currentUser ? `@${currentUser.username}` : "";
    const text = `Мой профиль в mmusic ${uname} (${uid}): ${realStats.totalPlays} прослушиваний, ${realStats.uniqueTrackIds.length} треков (${(realStats.totalSeconds / 3600).toFixed(1)} ч.)`;
    if (navigator.share) navigator.share({ title: "mmusic", text }).catch(() => {});
    else showNotice(text);
  }

  function fmtTime(sec) {
    if (!sec || isNaN(sec)) return "0:00";
    const m = Math.floor(sec / 60), s = Math.floor(sec % 60);
    return `${m}:${s < 10 ? "0" : ""}${s}`;
  }

  function escapeHtml(str) {
    return String(str || "").replace(/[&<>"']/g, (m) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[m]));
  }

  document.getElementById("fileInput").addEventListener("change", (e) => {
    const files = Array.from(e.target.files);
    if (!files.length) return;
    files.forEach((file, i) => {
      const url = URL.createObjectURL(file);
      const t = {
        id: "local_" + Date.now() + "_" + i,
        title: file.name.replace(/\.[^/.]+$/, ""),
        artist: "Локальный файл",
        album: "На устройстве",
        durationSec: 180,
        cover: DEFAULT_COVER_SVG,
        embeddable: true,
        url,
      };
      registerTracks([t]);
      displayTracks.unshift(t);
    });
    document.getElementById("libLocalCountText").textContent = `${files.length} треков`;
    renderAllViews();
    playSpecificTrack(displayTracks[0].id);
  });

  restoreSessionOnStartup();
  fetchTracksFromCatalog("Три дня дождя", false);
