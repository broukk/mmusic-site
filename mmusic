</head>
<body>

<!-- УВЕДОМЛЕНИЕ О СТАТУСЕ / ОШИБКАХ -->
<div id="appNoticeToast" class="app-notice-toast">
  <span class="icon filled" style="color:var(--md-primary)">info</span>
  <div id="appNoticeText" style="flex:1"></div>
</div>

<!-- ЭКРАН ЗАГРУЗКИ И АВТОМАТИЧЕСКОГО ВОССТАНОВЛЕНИЯ СЕССИИ -->
<div id="bootOverlay" class="boot-overlay">
