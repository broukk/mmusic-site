    clearTimeout(searchTimer);
    const q = val.trim();
    if (!q) {
      renderSearchResults(displayTracks.slice(0, 10));
      return;
    }
    document.getElementById("searchHeadingTitle").textContent = `Поиск: «${q}»`;
    searchTimer = setTimeout(() => {
      fetchTracksFromCatalog(q, false);
    }, 400);
  }

  function commitSearchHistory(val) {
    const q = val.trim();
    if (!q) return;
    searchHistory = [q, ...searchHistory.filter((x) => x.toLowerCase() !== q.toLowerCase())].slice(0, 5);
    saveRealStats();
    renderSearchHistory();
    fetchTracksFromCatalog(q, false);
  }

  function removeHistoryItem(idx, ev) {
    ev.stopPropagation();
    searchHistory.splice(idx, 1);
    saveRealStats();
    renderSearchHistory();
  }

  function selectHistoryQuery(q) {
    document.getElementById("searchInput").value = q;
    handleSearchInput(q);
  }

  function renderSearchHistory() {
    const box = document.getElementById("searchHistoryContainer");
    box.innerHTML = searchHistory.map((item, idx) => `
      <div class="history-item-row" onclick="selectHistoryQuery('${escapeHtml(item)}')">
        <div class="history-left"><span class="icon">history</span><span>${escapeHtml(item)}</span></div>
        <span class="icon" style="color:#8e8e93;font-size:20px" onclick="removeHistoryItem(${idx}, event)">close</span>
      </div>
    `).join("");
