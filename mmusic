<script>
  const DEFAULT_COVER_SVG = "data:image/svg+xml;utf8," + encodeURIComponent(`
    <svg xmlns="http://www.w3.org/2000/svg" width="300" height="300" viewBox="0 0 300 300">
      <rect width="300" height="300" rx="36" fill="#1f1d24"/>
      <circle cx="150" cy="150" r="64" fill="rgba(255,255,255,0.05)"/>
      <path d="M135 188V116l58-14v72" fill="none" stroke="#9e9aa4" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="122" cy="188" r="15" fill="#9e9aa4"/>
      <circle cx="180" cy="174" r="15" fill="#9e9aa4"/>
    </svg>
  `);

  let API_BASE_URL = (localStorage.getItem("mmusic_api_base_url") || "https://mmusic.work-sn1pee.workers.dev").replace(/\/+$/, "");

  // ============================================================================
  // 0. ЗАЩИЩЁННОЕ ХРАНИЛИЩЕ СЕССИИ (APK KEYSTORE BRIDGE / CAPACITOR / WEB)
  // ============================================================================
  const AuthStorage = {
    async getItem(key) {
      try {
        if (window.AndroidKeystoreBridge && typeof window.AndroidKeystoreBridge.getSecureItem === "function") {
          return window.AndroidKeystoreBridge.getSecureItem(key) || "";
        }
        const capPlugin = window.Capacitor?.Plugins?.SecureStoragePlugin;
        if (capPlugin && typeof capPlugin.get === "function") {
          const res = await capPlugin.get({ key });
          return res && res.value ? res.value : "";
        }
      } catch (_) {}
      return localStorage.getItem(key) || "";
    },
    async setItem(key, value) {
      try {
        if (window.AndroidKeystoreBridge && typeof window.AndroidKeystoreBridge.setSecureItem === "function") {
          window.AndroidKeystoreBridge.setSecureItem(key, String(value));
          return;
        }
        const capPlugin = window.Capacitor?.Plugins?.SecureStoragePlugin;
        if (capPlugin && typeof capPlugin.set === "function") {
          await capPlugin.set({ key, value: String(value) });
          return;
        }
      } catch (_) {}
      localStorage.setItem(key, String(value));
    },
    async removeItem(key) {
      try {
        if (window.AndroidKeystoreBridge && typeof window.AndroidKeystoreBridge.removeSecureItem === "function") {
          window.AndroidKeystoreBridge.removeSecureItem(key);
        }
        const capPlugin = window.Capacitor?.Plugins?.SecureStoragePlugin;
        if (capPlugin && typeof capPlugin.remove === "function") {
          await capPlugin.remove({ key });
        }
      } catch (_) {}
      localStorage.removeItem(key);
    }
  };

  let accessToken = "";
  let accessTokenExpiresAt = 0;
  let refreshToken = "";
  let csrfToken = "";
  let refreshInFlightPromise = null;

  let currentUser = null;
  let currentAuthMode = "login";
  let selectedTempStyle = "style-red";
  let selectedTempIcon = "graphic_eq";
  let tenureInterval = null;
  let statePollingTimer = null;
  let lastProfileUpdatedAt = 0;
  let lastLibraryUpdatedAt = 0;

  const authBroadcast = typeof BroadcastChannel !== "undefined" ? new BroadcastChannel("mmusic_auth_sync_v1") : null;
  if (authBroadcast) {
    authBroadcast.onmessage = (ev) => {
      const msg = ev.data || {};
      if (msg.type === "TOKENS_ROTATED") {
        accessToken = msg.accessToken || "";
        accessTokenExpiresAt = msg.accessTokenExpiresAt || 0;
        refreshToken = msg.refreshToken || "";
        csrfToken = msg.csrfToken || csrfToken;
      } else if (msg.type === "USER_UPDATED" && msg.user) {
        if (!currentUser || currentUser.id === msg.user.id) {
          currentUser = msg.user;
          localStorage.setItem("mmusic_cached_user_profile", JSON.stringify(currentUser));
          applyUserAvatarUI();
        }
      } else if (msg.type === "LOGGED_OUT") {
        purgeClientAuthStateAndShowLogin();
      }
    };
  }

  let knownTracksMap = new Map();
  let displayTracks = [];
  let nextSearchPageToken = null;
  let lastSearchQuery = "";

  let recentTracksIds = [];
  let favoriteIds = new Set();
  let searchHistory = [];
  const EMPTY_STATS = {
    totalPlays: 0,
    uniqueTrackIds: [],
    totalSeconds: 0,
    daysActive: [],
    hoursMap: {},
    weekdaysMap: {},
    artistsSeconds: {},
    artistCovers: {},
    trackPlaysMap: {},
  };
  let realStats = JSON.parse(JSON.stringify(EMPTY_STATS));

  let currentQueue = [];
  let currentIndex = -1;
  let isPlayingState = false;
  let isShuffle = false;
  let isRepeat = false;
  let dynamicColorBySong = true;
  let lastTimeUpdatePoint = 0;
  let currentTrackCountedAsPlay = false;

  const audio = document.getElementById("audioElement");
  let ytPlayer = null;
  let ytReady = false;
  let activeEngine = "yt";
  let ytProgressTimer = null;

  function showNotice(message, durationMs = 4500) {
    const box = document.getElementById("appNoticeToast");
    document.getElementById("appNoticeText").textContent = message;
    box.classList.add("show");
    clearTimeout(box._hideTimer);
    box._hideTimer = setTimeout(() => box.classList.remove("show"), durationMs);
  }

  function bindCoverImage(imgEl, url) {
    if (!imgEl) return;
    imgEl.style.opacity = "0.4";
    imgEl.onload = () => { imgEl.style.opacity = "1"; };
    imgEl.onerror = () => {
      imgEl.onerror = null;
      imgEl.src = DEFAULT_COVER_SVG;
      imgEl.style.opacity = "1";
    };
    imgEl.src = url || DEFAULT_COVER_SVG;
  }

  // ============================================================================
  // 1. ОФИЦИАЛЬНЫЙ YOUTUBE IFRAME PLAYER API
  // ============================================================================
  function onYouTubeIframeAPIReady() {
    if (window.location.protocol === "file:") {
      showNotice(
        "Внимание: страница открыта по протоколу file://. Для работы официального плеера YouTube требуется открытие по HTTPS или настройка baseUrl.",
        7000
      );
    }
    ytPlayer = new YT.Player("ytPlayerMount", {
      width: "100%",
      height: "100%",
      playerVars: {
        autoplay: 0,
        controls: 1,
        playsinline: 1,
        rel: 0,
        modestbranding: 1,
        origin: window.location.origin !== "null" ? window.location.origin : API_BASE_URL,
      },
      events: {
        onReady: () => { ytReady = true; },
        onStateChange: (ev) => {
          if (activeEngine !== "yt") return;
          if (ev.data === YT.PlayerState.PLAYING) {
            isPlayingState = true;
            const cur = currentQueue[currentIndex];
            if (cur && !currentTrackCountedAsPlay) {
              currentTrackCountedAsPlay = true;
              recordRealPlayStart(cur);
            }
            syncPlayerUI();
            startYtProgressLoop();
          } else if (ev.data === YT.PlayerState.PAUSED) {
            isPlayingState = false;
            syncPlayerUI();
          } else if (ev.data === YT.PlayerState.ENDED) {
            if (isRepeat && ytPlayer.seekTo) {
              ytPlayer.seekTo(0, true);
              ytPlayer.playVideo();
            } else {
              nextTrack();
            }
          }
        },
        onError: (ev) => {
          isPlayingState = false;
          syncPlayerUI();
          const code = ev.data;
          let reason = `Ошибка воспроизведения YouTube (код ${code}).`;
          if (code === 100) reason = "Видео удалено или скрыто настройками приватности.";
          if (code === 101 || code === 150) {
            reason = "Правообладатель запретил воспроизведение этого трека во встроенных плеерах вне YouTube.";
          }
          if (code === 153) {
            reason = "Ошибка конфигурации клиента (153): плеер YouTube требует запуска со страницы с HTTPS Origin.";
          }
          showNotice(reason, 6000);
        },
      },
    });
  }

  function startYtProgressLoop() {
    clearInterval(ytProgressTimer);
    ytProgressTimer = setInterval(() => {
      if (activeEngine !== "yt" || !ytReady || !ytPlayer || !ytPlayer.getCurrentTime) return;
      const curTrack = currentQueue[currentIndex];
      const curSec = ytPlayer.getCurrentTime() || 0;
      const durSec = ytPlayer.getDuration() || (curTrack && curTrack.durationSec) || 180;
      const pct = durSec > 0 ? Math.min(100, (curSec / durSec) * 100) : 0;

      const delta = curSec - lastTimeUpdatePoint;
      if (delta > 0 && delta < 3) {
        recordRealListeningDelta(delta, curTrack);
      }
      lastTimeUpdatePoint = curSec;

      document.getElementById("miniBar").style.width = `${pct}%`;
      document.getElementById("seekSlider").value = pct;
      document.getElementById("curTime").textContent = fmtTime(curSec);
      document.getElementById("durTime").textContent = fmtTime(durSec);
    }, 600);
  }

  // ============================================================================
  // 2. HTTP-КЛИЕНТ С АВТОМАТИЧЕСКИМ ОБНОВЛЕНИЕМ СЕССИИ И ЗАЩИТОЙ ОТ ГОНКИ ВКЛАДОК
  // ============================================================================
  async function persistSessionTokens({ newAccessToken, newAccessExpiresAt, newRefreshToken, newCsrfToken }) {
    if (newAccessToken !== undefined) {
      accessToken = newAccessToken;
      await AuthStorage.setItem("mmusic_access_token", newAccessToken);
    }
    if (newAccessExpiresAt !== undefined) {
      accessTokenExpiresAt = Number(newAccessExpiresAt) || 0;
      await AuthStorage.setItem("mmusic_access_exp", String(accessTokenExpiresAt));
    }
    if (newRefreshToken !== undefined && newRefreshToken !== null) {
      refreshToken = newRefreshToken;
      await AuthStorage.setItem("mmusic_refresh_token", newRefreshToken);
    }
    if (newCsrfToken) {
      csrfToken = newCsrfToken;
      await AuthStorage.setItem("mmusic_csrf_token", newCsrfToken);
    }
    if (authBroadcast) {
      authBroadcast.postMessage({
        type: "TOKENS_ROTATED",
        accessToken,
        accessTokenExpiresAt,
        refreshToken,
        csrfToken,
      });
    }
  }

  async function refreshSessionSingleFlight() {
    if (refreshInFlightPromise) {
      return refreshInFlightPromise;
    }

    refreshInFlightPromise = (async () => {
      try {
        const storedRefresh = refreshToken || (await AuthStorage.getItem("mmusic_refresh_token"));
        const dev = getDeviceDescription();
        const headers = { "Content-Type": "application/json" };
        if (csrfToken) headers["X-CSRF-Token"] = csrfToken;

        const res = await fetch(`${API_BASE_URL}/api/auth/refresh`, {
          method: "POST",
          credentials: "include",
          headers,
          body: JSON.stringify({
            refreshToken: storedRefresh || undefined,
            deviceName: dev.deviceName,
            platform: dev.platform,
          }),
        });

        if (res.status === 401 || res.status === 403) {
          return { ok: false, status: res.status, invalidSession: true };
        }
        if (!res.ok) {
          return { ok: false, status: res.status, invalidSession: false };
        }

        const data = await res.json();
        await persistSessionTokens({
          newAccessToken: data.accessToken || data.token || "",
          newAccessExpiresAt: data.accessTokenExpiresAt || (Date.now() + 15 * 60 * 1000),
          newRefreshToken: data.refreshToken !== undefined ? data.refreshToken : storedRefresh,
          newCsrfToken: data.csrfToken || csrfToken,
        });

        if (data.user) {
          currentUser = normalizeUserObject(data.user);
          localStorage.setItem("mmusic_cached_user_profile", JSON.stringify(currentUser));
        }

        return { ok: true, data };
      } catch (networkErr) {
        return { ok: false, networkError: true, invalidSession: false };
      } finally {
        refreshInFlightPromise = null;
      }
    })();

    return refreshInFlightPromise;
  }

  async function apiFetch(path, options = {}, allowRefresh = true) {
    const isExpiringSoon = accessTokenExpiresAt > 0 && Date.now() > accessTokenExpiresAt - 30000;
    if (allowRefresh && (!accessToken || isExpiringSoon) && (refreshToken || (await AuthStorage.getItem("mmusic_refresh_token")))) {
      await refreshSessionSingleFlight();
    }

    const headers = Object.assign({}, options.headers || {});
    if (accessToken) {
      headers["Authorization"] = `Bearer ${accessToken}`;
    }
    if (csrfToken && options.method && options.method !== "GET" && options.method !== "HEAD") {
      headers["X-CSRF-Token"] = csrfToken;
    }

    const fetchOpts = Object.assign({}, options, {
      credentials: "include",
      headers,
    });

    const response = await fetch(`${API_BASE_URL}${path}`, fetchOpts);

    if (response.status === 401 && allowRefresh) {
      const refResult = await refreshSessionSingleFlight();
      if (refResult.ok) {
        const retryHeaders = Object.assign({}, options.headers || {});
        if (accessToken) retryHeaders["Authorization"] = `Bearer ${accessToken}`;
        if (csrfToken && options.method && options.method !== "GET" && options.method !== "HEAD") {
          retryHeaders["X-CSRF-Token"] = csrfToken;
        }
        return fetch(`${API_BASE_URL}${path}`, Object.assign({}, options, {
          credentials: "include",
          headers: retryHeaders,
        }));
      }
    }

    return response;
  }

  // ============================================================================
  // 3. РАЗДЕЛЬНОЕ ХРАНЕНИЕ ДАННЫХ ПОЛЬЗОВАТЕЛЕЙ И СИНХРОНИЗАЦИЯ С D1
  // ============================================================================
  function getUserStorageKey(suffix) {
    const uidKey = currentUser && currentUser.id ? currentUser.id : "guest";
    return `mmusic_${uidKey}_${suffix}`;
  }

  function loadUserScopedData() {
    favoriteIds = new Set(JSON.parse(localStorage.getItem(getUserStorageKey("favs")) || "[]"));
    recentTracksIds = JSON.parse(localStorage.getItem(getUserStorageKey("recent")) || "[]");
    searchHistory = JSON.parse(
      localStorage.getItem(getUserStorageKey("search_hist")) || '["Три дня дождя","Кино","Скриптонит"]'
    );
    realStats = JSON.parse(
      localStorage.getItem(getUserStorageKey("stats")) || JSON.stringify(EMPTY_STATS)
    );
    const savedSettings = JSON.parse(localStorage.getItem(getUserStorageKey("settings")) || "{}");
    if (typeof savedSettings.dynamicColorBySong === "boolean") {
      dynamicColorBySong = savedSettings.dynamicColorBySong;
      document.getElementById("dynColorSwitch").classList.toggle("on", dynamicColorBySong);
      document.getElementById("potokModeText").textContent = dynamicColorBySong ? "Оттенок по песне" : "Обычная";
    }
    if (typeof savedSettings.amoled === "boolean") {
      if (savedSettings.amoled) document.documentElement.setAttribute("data-amoled", "true");
      else document.documentElement.removeAttribute("data-amoled");
      document.getElementById("amoledSwitch").classList.toggle("on", savedSettings.amoled);
    }
  }

  function applyServerLibraryPayload(lib) {
    if (!lib || typeof lib !== "object") return;
    if (Array.isArray(lib.favorites)) {
      favoriteIds = new Set(lib.favorites);
      localStorage.setItem(getUserStorageKey("favs"), JSON.stringify([...favoriteIds]));
    }
    if (Array.isArray(lib.recent)) {
      recentTracksIds = lib.recent;
      localStorage.setItem(getUserStorageKey("recent"), JSON.stringify(recentTracksIds));
    }
    if (Array.isArray(lib.searchHistory)) {
      searchHistory = lib.searchHistory;
      localStorage.setItem(getUserStorageKey("search_hist"), JSON.stringify(searchHistory));
    }
    if (lib.stats && typeof lib.stats.totalPlays === "number") {
      realStats = Object.assign(JSON.parse(JSON.stringify(EMPTY_STATS)), lib.stats);
      localStorage.setItem(getUserStorageKey("stats"), JSON.stringify(realStats));
    }
    if (lib.settings && typeof lib.settings === "object") {
      localStorage.setItem(getUserStorageKey("settings"), JSON.stringify(lib.settings));
      if (typeof lib.settings.dynamicColorBySong === "boolean") {
        dynamicColorBySong = lib.settings.dynamicColorBySong;
        document.getElementById("dynColorSwitch").classList.toggle("on", dynamicColorBySong);
      }
      if (typeof lib.settings.amoled === "boolean") {
        if (lib.settings.amoled) document.documentElement.setAttribute("data-amoled", "true");
        else document.documentElement.removeAttribute("data-amoled");
        document.getElementById("amoledSwitch").classList.toggle("on", lib.settings.amoled);
      }
    }
    if (lib.updatedAt) {
      lastLibraryUpdatedAt = Number(lib.updatedAt) || Date.now();
    }
  }

  async function saveRealStats() {
    if (!currentUser) return;
    const settingsObj = {
      dynamicColorBySong,
      amoled: document.documentElement.getAttribute("data-amoled") === "true",
    };
    localStorage.setItem(getUserStorageKey("favs"), JSON.stringify([...favoriteIds]));
    localStorage.setItem(getUserStorageKey("recent"), JSON.stringify(recentTracksIds));
    localStorage.setItem(getUserStorageKey("search_hist"), JSON.stringify(searchHistory));
    localStorage.setItem(getUserStorageKey("stats"), JSON.stringify(realStats));
    localStorage.setItem(getUserStorageKey("settings"), JSON.stringify(settingsObj));

    try {
      const res = await apiFetch("/api/user/sync", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          favorites: [...favoriteIds],
          recent: recentTracksIds,
          searchHistory,
          stats: realStats,
          settings: settingsObj,
        }),
      });
      if (res.ok) {
        const data = await res.json();
        if (data.updatedAt) lastLibraryUpdatedAt = Number(data.updatedAt) || Date.now();
      }
    } catch (_) {}
  }

  function resetRealStats() {
    realStats = JSON.parse(JSON.stringify(EMPTY_STATS));
    recentTracksIds = [];
    saveRealStats();
    renderStatsScreen();
    renderAllViews();
  }

  function recordRealPlayStart(track) {
    if (!track) return;
    realStats.totalPlays += 1;
    if (!realStats.uniqueTrackIds.includes(track.id)) {
      realStats.uniqueTrackIds.push(track.id);
    }
    realStats.trackPlaysMap[track.id] = (realStats.trackPlaysMap[track.id] || 0) + 1;

    const now = new Date();
    const dayKey = now.toISOString().slice(0, 10);
    if (!realStats.daysActive.includes(dayKey)) realStats.daysActive.push(dayKey);

    const hourKey = String(now.getHours()).padStart(2, "0") + ":00";
    realStats.hoursMap[hourKey] = (realStats.hoursMap[hourKey] || 0) + 1;

    const weekdays = ["Вс", "Пн", "Вт", "Ср", "Чт", "Пт", "Сб"];
    const wd = weekdays[now.getDay()];
    realStats.weekdaysMap[wd] = (realStats.weekdaysMap[wd] || 0) + 1;

    const primaryArtist = (track.artist || "Неизвестный").split(",")[0].trim();
    if (track.cover) realStats.artistCovers[primaryArtist] = track.cover;

    recentTracksIds = [track.id, ...recentTracksIds.filter((id) => id !== track.id)].slice(0, 50);
    saveRealStats();
    renderStatsScreen();
  }

  function recordRealListeningDelta(deltaSec, track) {
    if (!track || deltaSec <= 0 || deltaSec > 5) return;
    realStats.totalSeconds += deltaSec;
    const primaryArtist = (track.artist || "Неизвестный").split(",")[0].trim();
    realStats.artistsSeconds[primaryArtist] = (realStats.artistsSeconds[primaryArtist] || 0) + deltaSec;
    saveRealStats();
  }

  // ============================================================================
  // 4. ПОИСК И ПАГИНАЦИЯ YOUTUBE MUSIC ЧЕРЕЗ СЕРВЕРНЫЙ API
  // ============================================================================
  async function fetchTracksFromCatalog(query, appendPage = false) {
    const cleanQ = (query || "").trim();
    if (!cleanQ) return;

    const badge = document.getElementById("parserActiveBadge");
    badge.textContent = "Загрузка из YouTube...";

    try {
      const pageParam = appendPage && nextSearchPageToken ? `&pageToken=${encodeURIComponent(nextSearchPageToken)}` : "";
      const res = await fetch(`${API_BASE_URL}/api/youtube/search?q=${encodeURIComponent(cleanQ)}${pageParam}`);
      const data = await res.json();

      if (!res.ok) {
        badge.textContent = "Ошибка API";
        showNotice(data.error || "Не удалось выполнить поиск YouTube Music");
        return;
      }

      const incoming = data.tracks || [];
      nextSearchPageToken = data.nextPageToken || null;
      lastSearchQuery = cleanQ;

      document.getElementById("loadMoreSearchBtn").style.display = nextSearchPageToken ? "flex" : "none";

      if (incoming.length > 0) {
        registerTracks(incoming);
        displayTracks = appendPage ? [...displayTracks, ...incoming] : incoming;
        badge.textContent = `Найдено: ${displayTracks.length}`;
        renderAllViews();
        renderSearchResults(displayTracks);
      } else if (!appendPage) {
        displayTracks = [];
        badge.textContent = "Ничего не найдено";
        renderSearchResults([]);
      }
    } catch (err) {
      badge.textContent = "Офлайн-режим";
    }
  }

  function loadNextSearchPage() {
    if (lastSearchQuery && nextSearchPageToken) {
      fetchTracksFromCatalog(lastSearchQuery, true);
    }
  }

  // ============================================================================
  // 5. УПРАВЛЕНИЕ ПЛЕЕРОМ
  // ============================================================================
  function registerTracks(list) {
    list.forEach((t) => knownTracksMap.set(t.id, t));
  }

  function playSpecificTrack(id) {
    const found = knownTracksMap.get(id);
    if (!found) return;

    if (found.embeddable === false) {
      showNotice(found.restrictionReason || "Этот трек недоступен для встроенного воспроизведения по решению правообладателя.");
      return;
    }

    if (!currentQueue.some((t) => t.id === id)) {
      currentQueue = [...displayTracks];
    }
    currentIndex = currentQueue.findIndex((t) => t.id === id);
    if (currentIndex === -1) {
      currentQueue = [found, ...displayTracks];
      currentIndex = 0;
    }
    startPlaybackImmediate();
  }

  function startPlaybackImmediate() {
    const cur = currentQueue[currentIndex];
    if (!cur) return;

    if (cur.embeddable === false) {
      showNotice(cur.restrictionReason || "Трек ограничен правообладателем.");
      return;
    }

    document.getElementById("miniPlayer").classList.remove("hidden");
    lastTimeUpdatePoint = 0;
    currentTrackCountedAsPlay = false;

    audio.pause();
    clearInterval(ytProgressTimer);

    if (dynamicColorBySong && cur.cover) {
      extractColorFromCover(cur.cover);
    }
    syncPlayerUI();
    renderAllViews();

    const ytMount = document.getElementById("ytPlayerMount");

    if (cur.ytVideoId) {
      activeEngine = "yt";
      ytMount.style.display = "block";
      document.getElementById("fpSourceBadge").textContent = "YouTube Music";

      if (ytReady && ytPlayer && ytPlayer.loadVideoById) {
        ytPlayer.loadVideoById(cur.ytVideoId);
        ytPlayer.playVideo();
      } else {
        showNotice("Инициализация плеера YouTube...");
      }
      return;
    }

    if (cur.url) {
      activeEngine = "audio";
      ytMount.style.display = "none";
      if (ytReady && ytPlayer && ytPlayer.stopVideo) ytPlayer.stopVideo();

      audio.src = cur.url;
      audio.currentTime = 0;
      audio.play().then(() => {
        isPlayingState = true;
        document.getElementById("fpSourceBadge").textContent = "Локальный файл";
        if (!currentTrackCountedAsPlay) {
          currentTrackCountedAsPlay = true;
          recordRealPlayStart(cur);
        }
        syncPlayerUI();
      }).catch(() => {
        showNotice("Не удалось воспроизвести локальный аудиофайл.");
      });
    }
  }

  function togglePlay() {
    if (currentIndex === -1) {
      togglePotokPlay();
      return;
    }
    if (activeEngine === "yt" && ytReady && ytPlayer) {
      const st = ytPlayer.getPlayerState();
      if (st === YT.PlayerState.PLAYING) {
        ytPlayer.pauseVideo();
        isPlayingState = false;
      } else {
        ytPlayer.playVideo();
        isPlayingState = true;
      }
      syncPlayerUI();
      return;
    }
    if (audio.paused) {
      audio.play().then(() => { isPlayingState = true; syncPlayerUI(); }).catch(() => {});
    } else {
      audio.pause();
      isPlayingState = false;
      syncPlayerUI();
    }
  }

  function togglePotokPlay() {
    if (currentIndex !== -1 && isPlayingState) {
      togglePlay();
      return;
    }
    const playable = displayTracks.filter((t) => t.embeddable !== false);
    if (!playable.length) return;
    currentQueue = [...playable];
    currentIndex = 0;
    startPlaybackImmediate();
  }

  function nextTrack() {
    if (!currentQueue.length) return;
    currentIndex = isShuffle
      ? Math.floor(Math.random() * currentQueue.length)
      : (currentIndex + 1) % currentQueue.length;
    startPlaybackImmediate();
  }

  function prevTrack() {
    if (!currentQueue.length) return;
    if (activeEngine === "yt" && ytReady && ytPlayer && ytPlayer.getCurrentTime && ytPlayer.getCurrentTime() > 3) {
      ytPlayer.seekTo(0, true);
      return;
    }
    if (activeEngine === "audio" && audio.currentTime > 3) {
      audio.currentTime = 0;
      return;
    }
    currentIndex = (currentIndex - 1 + currentQueue.length) % currentQueue.length;
    startPlaybackImmediate();
  }

  function seekAudio(pct) {
    const cur = currentQueue[currentIndex];
    if (activeEngine === "yt" && ytReady && ytPlayer && ytPlayer.seekTo) {
      const dur = ytPlayer.getDuration() || (cur && cur.durationSec) || 180;
      const target = (pct / 100) * dur;
      ytPlayer.seekTo(target, true);
      lastTimeUpdatePoint = target;
      return;
    }
    const dur = audio.duration || (cur && cur.durationSec) || 180;
    audio.currentTime = (pct / 100) * dur;
    lastTimeUpdatePoint = audio.currentTime;
  }

  audio.addEventListener("play", () => { if (activeEngine === "audio") { isPlayingState = true; syncPlayerUI(); } });
  audio.addEventListener("pause", () => { if (activeEngine === "audio") { isPlayingState = false; syncPlayerUI(); } });
  audio.addEventListener("ended", () => { if (activeEngine === "audio" && !isRepeat) nextTrack(); });
  audio.addEventListener("timeupdate", () => {
    if (activeEngine !== "audio") return;
    const cur = currentQueue[currentIndex];
    const dur = audio.duration || (cur && cur.durationSec) || 180;
    const pct = Math.min(100, (audio.currentTime / dur) * 100);
    const delta = audio.currentTime - lastTimeUpdatePoint;
    if (delta > 0 && delta < 3) recordRealListeningDelta(delta, cur);
    lastTimeUpdatePoint = audio.currentTime;
    document.getElementById("miniBar").style.width = `${pct}%`;
    document.getElementById("seekSlider").value = pct;
    document.getElementById("curTime").textContent = fmtTime(audio.currentTime);
    document.getElementById("durTime").textContent = fmtTime(dur);
  });

  // ============================================================================
  // 6. РЕГИСТРАЦИЯ И ВХОД ПО ЛОГИНУ И ПАРОЛЮ, АВТОВОССТАНОВЛЕНИЕ И СИНХРОНИЗАЦИЯ
  // ============================================================================
  function getDeviceDescription() {
    const ua = navigator.userAgent || "Web Client";
    let platform = navigator.platform || "Web";
    if (/Android/i.test(ua)) platform = "Android";
    else if (/iPhone|iPad/i.test(ua)) platform = "iOS";
    else if (/Win/i.test(platform)) platform = "Windows";
    else if (/Mac/i.test(platform)) platform = "macOS";
    return { deviceName: `${platform} (${ua.slice(0, 48)})`, platform };
  }

  function normalizeUserObject(u) {
    if (!u) return null;
    const serialNum = Number(u.serial || 1);
    const formattedPublicId = u.publicId || u.uid || `#MM-${10000 + serialNum}`;
    return {
      id: u.id,
      username: u.username || u.login || "user",
      name: u.displayName || u.name || u.username || "Пользователь",
      publicId: formattedPublicId,
      uid: formattedPublicId,
      serial: serialNum,
      avatarStyle: u.avatarStyle || "style-red",
      avatarIcon: u.avatarIcon || "graphic_eq",
      registeredAt: Number(u.registeredAt || u.createdAt || Date.now()),
      updatedAt: Number(u.updatedAt || Date.now()),
      role: u.role || "user",
    };
  }

  function togglePasswordVisibility(inputId, iconId) {
    const inp = document.getElementById(inputId);
    const ic = document.getElementById(iconId);
    if (!inp || !ic) return;
    if (inp.type === "password") {
      inp.type = "text";
      ic.textContent = "visibility_off";
    } else {
      inp.type = "password";
      ic.textContent = "visibility";
    }
  }

  async function restoreSessionOnStartup() {
    document.getElementById("backendApiUrlInput").value = API_BASE_URL;
    const bootOverlay = document.getElementById("bootOverlay");
    const bootStatus = document.getElementById("bootStatusText");

    accessToken = await AuthStorage.getItem("mmusic_access_token");
    accessTokenExpiresAt = Number(await AuthStorage.getItem("mmusic_access_exp")) || 0;
    refreshToken = await AuthStorage.getItem("mmusic_refresh_token");
    csrfToken = await AuthStorage.getItem("mmusic_csrf_token");

    const cachedProfileRaw = localStorage.getItem("mmusic_cached_user_profile");
    const cachedProfile = cachedProfileRaw ? normalizeUserObject(JSON.parse(cachedProfileRaw)) : null;

    try {
      bootStatus.textContent = "Проверка аккаунта...";
      const res = await apiFetch("/api/auth/me", { method: "GET" }, true);

      if (res.ok) {
        const data = await res.json();
        currentUser = normalizeUserObject(data.user);
        lastProfileUpdatedAt = currentUser.updatedAt || Date.now();
        localStorage.setItem("mmusic_cached_user_profile", JSON.stringify(currentUser));

        loadUserScopedData();
        if (data.library) {
          applyServerLibraryPayload(data.library);
        }

        bootOverlay.classList.add("hidden");
        document.getElementById("authOverlay").classList.add("hidden");
        applyUserAvatarUI();
        renderAllViews();
        startRealtimeStatePolling();
        loadSessionsAndHistory();
        return;
      }

      if (res.status === 401 || res.status === 403) {
        await purgeClientAuthStateAndShowLogin();
        bootOverlay.classList.add("hidden");
        return;
      }

      // Ошибка сервера 5xx: не удаляем сессию, если есть кеш профиля
      if (cachedProfile && (accessToken || refreshToken)) {
        enterOfflineCachedMode(cachedProfile, "Сервер временно недоступен. Открыт сохранённый профиль.");
        bootOverlay.classList.add("hidden");
        return;
      }

      await purgeClientAuthStateAndShowLogin();
      bootOverlay.classList.add("hidden");
    } catch (networkErr) {
      // Временное отсутствие интернета: НЕ удаляем сохранённую сессию и восстанавливаем кеш профиля
      if (cachedProfile && (accessToken || refreshToken)) {
        enterOfflineCachedMode(cachedProfile, "Нет соединения с сервером. Вход восстановлен локально.");
        bootOverlay.classList.add("hidden");
        return;
      }
      bootOverlay.classList.add("hidden");
      document.getElementById("authOverlay").classList.remove("hidden");
      goToAuthStep("welcome");
    }
  }

  function enterOfflineCachedMode(cachedProfile, noticeMessage) {
    currentUser = cachedProfile;
    loadUserScopedData();
    document.getElementById("authOverlay").classList.add("hidden");
    applyUserAvatarUI();
    renderAllViews();
    startRealtimeStatePolling();
    showNotice(noticeMessage, 5500);
  }

  async function submitCredentialsAuth() {
    const isReg = currentAuthMode === "register";
    const usernameInput = document.getElementById("authUsernameInput").value.trim();
    // Пароль НЕ изменяем автоматически: НЕ обрезаем пробелы и НЕ меняем регистр
    const rawPassword = document.getElementById("authPasswordInput").value;
    const rawConfirmPassword = document.getElementById("authPasswordConfirmInput").value;
    const displayNameInput = document.getElementById("authDisplayNameInput").value.trim();
    const errEl = document.getElementById("credentialsStepError");
    const submitBtn = document.getElementById("submitCredentialsBtn");

    errEl.style.display = "none";

    if (!/^[a-zA-Z0-9_-]{3,24}$/.test(usernameInput)) {
      errEl.textContent = "Логин должен содержать от 3 до 24 символов: латинские буквы, цифры, «_» или «-».";
      errEl.style.display = "block";
      return;
    }

    if (rawPassword.length < 8 || rawPassword.length > 72) {
      errEl.textContent = isReg
        ? "Пароль должен содержать от 8 до 72 символов."
        : "Неверный логин или пароль";
      errEl.style.display = "block";
      return;
    }

    if (isReg && rawPassword !== rawConfirmPassword) {
      errEl.textContent = "Введённые пароли не совпадают.";
      errEl.style.display = "block";
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = isReg ? "Создание аккаунта..." : "Вход...";

    try {
      const dev = getDeviceDescription();
      const endpoint = isReg ? "/api/auth/register" : "/api/auth/login";
      const payload = {
        username: usernameInput,
        password: rawPassword,
        deviceName: dev.deviceName,
        platform: dev.platform,
      };

      if (isReg) {
        payload.displayName = displayNameInput || usernameInput;
        payload.avatarStyle = selectedTempStyle;
        payload.avatarIcon = selectedTempIcon;
      }

      const res = await fetch(`${API_BASE_URL}${endpoint}`, {
        method: "POST",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      const data = await res.json().catch(() => ({}));

      if (!res.ok) {
        if (!isReg && res.status === 401) {
          errEl.textContent = "Неверный логин или пароль";
        } else {
          errEl.textContent = data.error || (isReg ? "Не удалось зарегистрировать аккаунт" : "Неверный логин или пароль");
        }
        errEl.style.display = "block";
        return;
      }

      document.getElementById("authPasswordInput").value = "";
      document.getElementById("authPasswordConfirmInput").value = "";

      await completeClientLogin(data);
    } catch (e) {
      errEl.textContent = "Нет связи с сервером. Проверьте интернет или адрес API.";
      errEl.style.display = "block";
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = isReg ? "Зарегистрироваться" : "Войти";
    }
  }

  async function completeClientLogin(authData) {
    await persistSessionTokens({
      newAccessToken: authData.accessToken || authData.token || "",
      newAccessExpiresAt: authData.accessTokenExpiresAt || (Date.now() + 15 * 60 * 1000),
      newRefreshToken: authData.refreshToken || "",
      newCsrfToken: authData.csrfToken || "",
    });

    currentUser = normalizeUserObject(authData.user);
    lastProfileUpdatedAt = currentUser.updatedAt || Date.now();
    localStorage.setItem("mmusic_cached_user_profile", JSON.stringify(currentUser));

    loadUserScopedData();
    if (authData.library) {
      applyServerLibraryPayload(authData.library);
    }

    document.getElementById("authOverlay").classList.add("hidden");
    applyUserAvatarUI();
    renderAllViews();
    startRealtimeStatePolling();
    loadSessionsAndHistory();

    if (authBroadcast) {
      authBroadcast.postMessage({ type: "USER_UPDATED", user: currentUser });
    }
  }

  // Периодический опрос состояния текущего пользователя каждые 5 секунд (ожидаемая задержка до 5 с между устройствами)
  function startRealtimeStatePolling() {
    clearInterval(statePollingTimer);
    statePollingTimer = setInterval(async () => {
      if (!currentUser || document.visibilityState !== "visible") return;
      try {
        const res = await apiFetch(
          `/api/user/state?profileSince=${lastProfileUpdatedAt}&libSince=${lastLibraryUpdatedAt}`,
          { method: "GET" },
          true
        );
        if (res.status === 401) {
          await purgeClientAuthStateAndShowLogin();
          return;
        }
        if (!res.ok) return;
        const data = await res.json();

        if (data.user) {
          const incomingUser = normalizeUserObject(data.user);
          if (incomingUser.updatedAt >= lastProfileUpdatedAt) {
            currentUser = incomingUser;
            lastProfileUpdatedAt = incomingUser.updatedAt;
            localStorage.setItem("mmusic_cached_user_profile", JSON.stringify(currentUser));
            applyUserAvatarUI();
          }
        }
        if (data.library && Number(data.library.updatedAt || 0) > lastLibraryUpdatedAt) {
          applyServerLibraryPayload(data.library);
          renderAllViews();
        }
      } catch (_) {}
    }, 5000);
  }

  async function saveProfileChangesToServer() {
    if (!currentUser) return;
    const newName = document.getElementById("profileEditNameInput").value.trim();
    if (!newName && !currentUser.avatarStyle) return;

    try {
      const res = await apiFetch("/api/user/profile", {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          displayName: newName || currentUser.name,
          avatarStyle: currentUser.avatarStyle,
          avatarIcon: currentUser.avatarIcon,
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        showNotice(data.error || "Не удалось обновить профиль на сервере");
        return;
      }
      if (data.user) {
        currentUser = normalizeUserObject(data.user);
        lastProfileUpdatedAt = currentUser.updatedAt || Date.now();
        localStorage.setItem("mmusic_cached_user_profile", JSON.stringify(currentUser));
        document.getElementById("profileEditNameInput").value = "";
        applyUserAvatarUI();
        if (authBroadcast) {
          authBroadcast.postMessage({ type: "USER_UPDATED", user: currentUser });
        }
        showNotice("Профиль мгновенно обновлён");
      }
    } catch (_) {
      showNotice("Сервер недоступен: не удалось сохранить изменения профиля");
    }
  }

  async function loadSessionsAndHistory() {
    if (!currentUser) return;
    try {
      const res = await apiFetch("/api/auth/sessions", { method: "GET" });
      if (!res.ok) return;
      const data = await res.json();

      const activeBox = document.getElementById("activeSessionsContainer");
      const historyBox = document.getElementById("loginHistoryContainer");

      activeBox.innerHTML = (data.sessions || []).map((s) => {
        const isCurrent = s.id === data.currentSessionId;
        return `
          <div class="session-item-row">
            <div style="min-width:0;flex:1">
              <div style="font-size:13px;font-weight:700;color:#fff">
                ${escapeHtml(s.device_name)} ${isCurrent ? '<span style="color:var(--md-primary)">(Текущее)</span>' : ""}
              </div>
              <div style="font-size:11px;color:#8e8e93;margin-top:2px">
                Подсеть: ${escapeHtml(s.ip_masked)} • Активность: ${formatRussianRegDate(s.last_active_at)}
              </div>
            </div>
            ${!isCurrent ? `<button class="lib-pill-btn" style="height:30px;padding:0 10px;font-size:11px;color:#ff6b6b" onclick="revokeSpecificSession('${escapeHtml(s.id)}')">Завершить</button>` : ""}
          </div>
        `;
      }).join("");

      historyBox.innerHTML = (data.history || []).slice(0, 8).map((h) => `
        <div style="font-size:12px;color:#9e9aa4;padding:6px 0;border-bottom:1px solid rgba(255,255,255,0.05)">
          <b style="color:#fff">${escapeHtml(h.auth_method)}</b> • ${escapeHtml(h.platform)} (${escapeHtml(h.ip_masked)})<br>
          <span>${formatRussianRegDate(h.created_at)}</span>
        </div>
      `).join("");
    } catch (_) {}
  }

  async function revokeSpecificSession(sessionId) {
    if (!currentUser) return;
    await apiFetch("/api/auth/revoke-session", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ sessionId }),
    });
    loadSessionsAndHistory();
  }

  async function logoutCurrentSession() {
    try {
      const storedRefresh = refreshToken || (await AuthStorage.getItem("mmusic_refresh_token"));
      await apiFetch("/api/auth/logout", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ refreshToken: storedRefresh || undefined }),
      }, false);
    } catch (_) {}
    if (authBroadcast) authBroadcast.postMessage({ type: "LOGGED_OUT" });
    await purgeClientAuthStateAndShowLogin();
  }

  async function logoutAllDevices() {
    if (!currentUser) return;
    try {
      await apiFetch("/api/auth/logout-all", { method: "POST" }, true);
    } catch (_) {}
    if (authBroadcast) authBroadcast.postMessage({ type: "LOGGED_OUT" });
    await purgeClientAuthStateAndShowLogin();
  }

  async function purgeClientAuthStateAndShowLogin() {
    clearInterval(statePollingTimer);
    clearInterval(tenureInterval);
    accessToken = "";
    accessTokenExpiresAt = 0;
    refreshToken = "";
    csrfToken = "";
    currentUser = null;

    await AuthStorage.removeItem("mmusic_access_token");
    await AuthStorage.removeItem("mmusic_access_exp");
    await AuthStorage.removeItem("mmusic_refresh_token");
    await AuthStorage.removeItem("mmusic_csrf_token");
    localStorage.removeItem("mmusic_cached_user_profile");

    favoriteIds = new Set();
    recentTracksIds = [];
    realStats = JSON.parse(JSON.stringify(EMPTY_STATS));
    renderAllViews();
    document.getElementById("authOverlay").classList.remove("hidden");
    goToAuthStep("welcome");
  }

  function saveBackendApiUrl() {
    const val = document.getElementById("backendApiUrlInput").value.trim().replace(/\/+$/, "");
    if (!val) return;
    API_BASE_URL = val;
    localStorage.setItem("mmusic_api_base_url", API_BASE_URL);
    showNotice("Адрес серверного API сохранён");
    fetchTracksFromCatalog("Три дня дождя");
  }

  function formatRussianRegDate(ts) {
    if (!ts) return "—";
    return new Date(Number(ts)).toLocaleString("ru-RU", {
      day: "numeric",
      month: "short",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  }

  function updateRegistrationTenureCounter() {
    const el = document.getElementById("profileTenureCounter");
    if (!currentUser || !currentUser.registeredAt || !el) return;
    const diffSec = Math.max(0, Math.floor((Date.now() - currentUser.registeredAt) / 1000));
    const days = Math.floor(diffSec / 86400);
    const hrs = String(Math.floor((diffSec % 86400) / 3600)).padStart(2, "0");
    const mins = String(Math.floor((diffSec % 3600) / 60)).padStart(2, "0");
    const secs = String(diffSec % 60).padStart(2, "0");
    el.textContent = `${days} дн. ${hrs}:${mins}:${secs}`;
  }

  function goToAuthStep(stepName) {
    document.querySelectorAll(".auth-step").forEach((s) => s.classList.remove("active"));
    if (stepName === "welcome") document.getElementById("authStepWelcome").classList.add("active");
    if (stepName === "credentials") document.getElementById("authStepCredentials").classList.add("active");
  }

  function openCredentialsAuthFlow(mode) {
    currentAuthMode = mode;
    const isReg = mode === "register";
    document.getElementById("authStepCredentialsHeader").textContent = isReg ? "Создание аккаунта" : "Вход в аккаунт";
    document.getElementById("avatarSelectBlock").style.display = isReg ? "block" : "none";
    document.getElementById("nameInputBoxWrap").style.display = isReg ? "flex" : "none";
    document.getElementById("confirmPasswordWrap").style.display = isReg ? "block" : "none";
    document.getElementById("authPasswordInput").setAttribute("autocomplete", isReg ? "new-password" : "current-password");
    document.getElementById("submitCredentialsBtn").textContent = isReg ? "Зарегистрироваться" : "Войти";
    document.getElementById("toggleAuthModeBtn").textContent = isReg ? "Уже есть аккаунт? Войти" : "Создать новый аккаунт";
    document.getElementById("credentialsStepError").style.display = "none";
    goToAuthStep("credentials");
  }

  function toggleBetweenLoginAndRegister() {
    openCredentialsAuthFlow(currentAuthMode === "register" ? "login" : "register");
  }

  function setAvatarStyle(styleClass, iconName, btnEl) {
    selectedTempStyle = styleClass;
    selectedTempIcon = iconName;
    const box = document.getElementById("authMd3Avatar");
    box.className = `md3-user-avatar ${styleClass}`;
    document.getElementById("authMd3AvatarIcon").textContent = iconName;
    if (btnEl) {
      document.querySelectorAll(".avatar-style-pill").forEach((b) => b.classList.remove("active"));
      btnEl.classList.add("active");
    }
  }

  async function cycleUserAvatarStyle() {
    if (!currentUser) return;
    const styles = [
      { cls: "style-red", icon: "graphic_eq", label: "Красная" },
      { cls: "style-black", icon: "album", label: "Чёрная" },
      { cls: "style-song", icon: "auto_awesome", label: "По песне" },
      { cls: "style-green", icon: "equalizer", label: "Зелёная" },
      { cls: "style-violet", icon: "headphones", label: "Фиолетовая" },
    ];
    const idx = styles.findIndex((s) => s.cls === currentUser.avatarStyle);
    const next = styles[(idx + 1) % styles.length];
    currentUser.avatarStyle = next.cls;
    currentUser.avatarIcon = next.icon;
    document.getElementById("currentStyleLabel").textContent = next.label;
    applyUserAvatarUI();
    await saveProfileChangesToServer();
  }

  function applyUserAvatarUI() {
    if (!currentUser) return;
    const pBox = document.getElementById("profileAvatarBox");
    const pIcon = document.getElementById("profileAvatarIcon");
    if (pBox && pIcon) {
      pBox.className = `md3-user-avatar ${currentUser.avatarStyle || "style-red"}`;
      pIcon.textContent = currentUser.avatarIcon || "graphic_eq";
    }
    document.getElementById("profileNameText").textContent = currentUser.name;
    document.getElementById("profileHandleText").textContent = `@${currentUser.username}`;
    document.getElementById("profileProviderBadge").textContent = "Аккаунт D1 • Постоянный ID";
    document.getElementById("profileUidValue").textContent = currentUser.publicId || currentUser.uid;
    document.getElementById("profileSerialValue").textContent = `Пользователь №${currentUser.serial}`;
