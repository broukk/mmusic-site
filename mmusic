          <div class="for-you-art-stack">
            <img class="stack-side-img left" src="${prevCov}" alt="" onerror="this.onerror=null;this.src=DEFAULT_COVER_SVG">
            <img class="stack-side-img right" src="${nextCov}" alt="" onerror="this.onerror=null;this.src=DEFAULT_COVER_SVG">
            <img class="stack-main-img" src="${mainCov}" alt="" onerror="this.onerror=null;this.src=DEFAULT_COVER_SVG">
          </div>
          <div class="for-you-title">${escapeHtml(t.title)}</div>
          <div class="for-you-sub">${escapeHtml(t.artist)}</div>
        </div>
      `;
    }).join("");

    document.getElementById("homeTrackList").innerHTML = renderTrackRowsHtml(displayTracks);
    document.getElementById("favDetailTrackList").innerHTML = renderTrackRowsHtml(favTracks);
    document.getElementById("libraryContentBox").innerHTML = renderTrackRowsHtml(displayTracks.slice(0, 15));
    renderSearchHistory();
    renderStatsScreen();
  }

  function openFavoritesDetailScreen() {
    document.querySelectorAll(".screen").forEach((s) => s.classList.remove("active"));
    document.getElementById("tab-fav-detail").classList.add("active");
  }

  function openRecentTracksView() {
    const recList = recentTracksIds.map((id) => knownTracksMap.get(id)).filter(Boolean);
    if (recList.length) {
      currentQueue = recList;
      currentIndex = 0;
      startPlaybackImmediate();
    }
  }

  function playAllFavorites() {
    const favTracks = [...knownTracksMap.values()].filter((t) => favoriteIds.has(t.id));
    if (!favTracks.length) return;
    currentQueue = favTracks;
    currentIndex = 0;
    startPlaybackImmediate();
  }

  function shuffleFavoritesAndPlay() {
    const favTracks = [...knownTracksMap.values()].filter((t) => favoriteIds.has(t.id)).sort(() => Math.random() - 0.5);
    if (!favTracks.length) return;
    currentQueue = favTracks;
    currentIndex = 0;
    startPlaybackImmediate();
  }

  function filterLibraryView(mode, btnEl) {
    document.querySelectorAll(".lib-pill-btn").forEach((b) => b.classList.remove("active"));
    if (btnEl) btnEl.classList.add("active");
    document.getElementById("libraryContentBox").innerHTML = renderTrackRowsHtml(displayTracks);
