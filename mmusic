<!DOCTYPE html>
<html lang="ru" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>mmusic</title>
<link href="https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wght@8..144,400;8..144,500;8..144,600;8..144,700;8..144,800;8..144,900&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,300..700,0..1,0" rel="stylesheet">
<style>
  :root {
    --seed-h: 10;
    --seed-s: 75%;
    --md-background: #0d0c0e;
    --md-surface: #141316;
    --md-surface-container-low: #18171b;
    --md-surface-container: #1f1d22;
    --md-surface-container-high: #29272d;
    --md-surface-container-highest: #343239;
    --md-primary: hsl(var(--seed-h), var(--seed-s), 65%);
    --md-on-primary: hsl(var(--seed-h), var(--seed-s), 12%);
    --md-primary-container: hsl(var(--seed-h), calc(var(--seed-s) * 0.7), 24%);
    --md-on-primary-container: hsl(var(--seed-h), var(--seed-s), 92%);
    --md-on-surface: #f3eff4;
    --md-on-surface-variant: #9e9aa4;
    --md-outline-variant: rgba(255, 255, 255, 0.08);
    --hero-bg-tint: hsl(var(--seed-h), 26%, 15%);
  }

  [data-amoled="true"] {
    --md-background: #000000;
    --md-surface: #080808;
    --md-surface-container-low: #101012;
    --md-surface-container: #161618;
    --md-surface-container-high: #202024;
    --md-surface-container-highest: #2a2a2e;
    --hero-bg-tint: #141212;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
  html, body {
    height: 100dvh;
    background-color: var(--md-background);
    color: var(--md-on-surface);
    font-family: 'Roboto Flex', sans-serif;
    overflow: hidden;
    user-select: none;
  }
  body { display: flex; flex-direction: column; }

  .icon {
    font-family: 'Material Symbols Rounded';
    font-size: 24px;
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }
  .icon.filled { font-variation-settings: 'FILL' 1, 'wght' 600, 'GRAD' 0, 'opsz' 24; }

  .app-notice-toast {
    position: fixed;
    top: max(14px, env(safe-area-inset-top));
    left: 16px;
    right: 16px;
    max-width: 420px;
    margin: 0 auto;
    background: #252229;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 18px;
    padding: 12px 16px;
    z-index: 500;
    display: none;
    align-items: center;
    gap: 12px;
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.65);
    font-size: 13px;
    line-height: 1.4;
  }
  .app-notice-toast.show { display: flex; }

  .boot-overlay {
    position: fixed;
    inset: 0;
    background: #08080a;
    color: #ffffff;
    z-index: 350;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    transition: opacity 0.22s ease;
  }
  .boot-overlay.hidden {
    opacity: 0;
    pointer-events: none;
    display: none;
  }
  .boot-spinner {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 3px solid rgba(255, 255, 255, 0.14);
    border-top-color: var(--md-primary);
    animation: spinLoader 0.8s linear infinite;
  }
  @keyframes spinLoader {
    to { transform: rotate(360deg); }
  }

  .auth-overlay {
    position: fixed;
    inset: 0;
    background: #08080a;
    color: #ffffff;
    z-index: 250;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: max(22px, env(safe-area-inset-top)) 24px max(26px, env(safe-area-inset-bottom));
    overflow-y: auto;
  }
  .auth-overlay.hidden { display: none; }

  .auth-step {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100%;
    max-width: 400px;
    width: 100%;
    margin: 0 auto;
    gap: 18px;
  }
  .auth-step.active { display: flex; }

  .welcome-center {
    margin: auto 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .book-circle-emblem {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
  }
  .welcome-book-svg { width: 76px; height: 60px; overflow: visible; }
  .wb-cover { fill: none; stroke: #ffffff; stroke-width: 2.5; stroke-linecap: round; }
  .wb-page { fill: rgba(255, 255, 255, 0.15); stroke: #ffffff; stroke-width: 2.1; stroke-linejoin: round; }
  .wb-leaf {
    fill: #ffffff;
    stroke: #ffffff;
    stroke-width: 1.8;
    transform-origin: 17px 19px;
    animation: flipPage 2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }
  @keyframes flipPage {
    0% { transform: perspective(120px) rotateY(0deg) scaleX(1); }
    50% { transform: perspective(120px) rotateY(-90deg) scaleX(0.2); }
    100% { transform: perspective(120px) rotateY(-180deg) scaleX(-1); }
  }

  .md3-user-avatar {
    width: 84px;
    height: 84px;
    border-radius: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    border: 2px solid rgba(255, 255, 255, 0.16);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45);
    flex-shrink: 0;
  }
  .md3-user-avatar.style-red { background: linear-gradient(135deg, #b71c1c, #e53935); }
  .md3-user-avatar.style-black { background: linear-gradient(135deg, #09090b, #27272a); border-color: rgba(255, 255, 255, 0.28); }
  .md3-user-avatar.style-song { background: linear-gradient(135deg, var(--md-primary-container), var(--md-primary)); color: var(--md-on-primary); }
  .md3-user-avatar.style-green { background: linear-gradient(135deg, #1b5e20, #43a047); }
  .md3-user-avatar.style-violet { background: linear-gradient(135deg, #4a148c, #8e24aa); }

  .avatar-style-selector {
    display: flex;
    gap: 8px;
    justify-content: center;
    flex-wrap: wrap;
    margin: 10px 0 16px;
  }
  .avatar-style-pill {
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #151518;
    color: #d4d4d8;
    font-family: inherit;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
  }
  .avatar-style-pill.active { background: #ffffff; color: #000000; border-color: #ffffff; }

  .auth-input-box {
    width: 100%;
    height: 52px;
    border-radius: 16px;
    background: #151518;
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    padding: 0 14px;
    gap: 10px;
    margin-bottom: 10px;
  }
  .auth-input-box:focus-within {
    border-color: rgba(255, 255, 255, 0.28);
  }
  .auth-input-box input {
    flex: 1;
    background: transparent;
    border: none;
    color: #ffffff;
    font-size: 15px;
    font-family: inherit;
    outline: none;
    min-width: 0;
  }
  .auth-input-box input::placeholder { color: #71717a; }

  .input-eye-btn {
    background: none;
    border: none;
    color: #8e8e93;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
  }

  .field-hint {
    font-size: 11px;
    color: #8e8e93;
    text-align: left;
    margin: -4px 4px 10px;
    line-height: 1.35;
  }

  .btn-white-pill {
    width: 100%;
    height: 52px;
    border-radius: 999px;
    border: none;
    background: #ffffff;
    color: #000000;
    font-family: inherit;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .btn-white-pill:disabled { opacity: 0.5; cursor: not-allowed; }
  .btn-dark-pill {
    width: 100%;
    height: 52px;
    border-radius: 999px;
    border: 1px solid #242429;
    background: #0e0e11;
    color: #ffffff;
    font-family: inherit;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .btn-dark-pill:disabled { opacity: 0.45; cursor: not-allowed; }

  main {
    flex: 1;
    overflow-y: auto;
    padding-bottom: calc(165px + env(safe-area-inset-bottom));
    max-width: 480px;
    width: 100%;
    margin: 0 auto;
    scrollbar-width: none;
  }
  main::-webkit-scrollbar { display: none; }

  .screen { display: none; }
  .screen.active { display: block; }

  .potok-top-section {
    position: relative;
    overflow: hidden;
    padding: max(20px, env(safe-area-inset-top)) 18px 20px;
    background: linear-gradient(180deg, var(--hero-bg-tint) 0%, var(--md-background) 100%);
    transition: background 0.4s ease;
  }
  .potok-bg-ribbon {
    position: absolute;
    right: -30px;
    top: 15px;
    width: 340px;
    height: 290px;
    pointer-events: none;
    opacity: 0.16;
  }
  .potok-header-bar {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 14px;
  }
  .potok-giant-title { font-size: 46px; font-weight: 900; line-height: 0.96; letter-spacing: -1.4px; color: #ffffff; }
  .top-bell-btn {
    width: 42px; height: 42px; border-radius: 21px; border: none;
    background: transparent; color: #ffffff; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
  }
  .potok-collage-stage { position: relative; z-index: 2; height: 225px; margin-bottom: 12px; }
  .hero-cover-main {
    position: absolute; left: 0; top: 18px; width: 154px; height: 154px;
    border-radius: 26px; object-fit: cover; box-shadow: 0 16px 36px rgba(0, 0, 0, 0.55);
    background: var(--md-surface-container-high);
  }
  .hero-cover-top-right {
    position: absolute; right: 16px; top: 0; width: 86px; height: 86px;
    border-radius: 22px; object-fit: cover; box-shadow: 0 12px 28px rgba(0, 0, 0, 0.5);
    background: var(--md-surface-container-high);
  }
  .hero-cover-mid-right {
    position: absolute; right: 68px; top: 102px; width: 80px; height: 80px;
    border-radius: 20px; object-fit: cover; box-shadow: 0 12px 28px rgba(0, 0, 0, 0.5);
    background: var(--md-surface-container-high);
  }
  .potok-controls-row {
    position: relative; z-index: 2; display: flex; align-items: center;
    justify-content: space-between; padding: 0 6px; margin-bottom: 22px;
  }
  .potok-mode-label { display: inline-flex; align-items: center; gap: 8px; color: #d4d0d8; font-size: 14px; font-weight: 500; cursor: pointer; }
  .potok-white-play-btn {
    width: 82px; height: 82px; border-radius: 50%; border: none;
    background: #ffffff; color: #000000; display: flex; align-items: center;
    justify-content: center; cursor: pointer; box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
  }

  .dual-shortcut-row {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px;
    padding: 0 16px; margin-bottom: 26px;
  }
  .shortcut-pill-card {
    display: flex; align-items: center; gap: 10px; height: 58px;
    padding: 4px 12px 4px 4px; border-radius: 16px;
    background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.06); cursor: pointer;
  }
  .shortcut-thumb { width: 50px; height: 50px; border-radius: 12px; object-fit: cover; flex-shrink: 0; background: #222028; }
  .shortcut-info { min-width: 0; flex: 1; }
  .shortcut-title { font-size: 14px; font-weight: 700; color: #ffffff; display: flex; align-items: center; gap: 5px; }
  .shortcut-sub { font-size: 12px; color: var(--md-on-surface-variant); margin-top: 2px; }

  .home-section-title { font-size: 22px; font-weight: 800; letter-spacing: -0.4px; padding: 0 16px; margin-bottom: 14px; }
  .for-you-scroll { display: flex; gap: 14px; overflow-x: auto; padding: 0 16px 8px; margin-bottom: 24px; scrollbar-width: none; }
  .for-you-scroll::-webkit-scrollbar { display: none; }
  .for-you-card { width: 176px; flex-shrink: 0; cursor: pointer; }
  .for-you-art-stack { position: relative; width: 176px; height: 164px; margin-bottom: 10px; display: flex; align-items: center; justify-content: center; }
  .stack-side-img { position: absolute; width: 128px; height: 128px; border-radius: 20px; object-fit: cover; opacity: 0.55; background: #222028; }
  .stack-side-img.left { left: 0; transform: rotate(-6deg) scale(0.92); }
  .stack-side-img.right { right: 0; transform: rotate(6deg) scale(0.92); }
  .stack-main-img { position: relative; z-index: 2; width: 148px; height: 148px; border-radius: 24px; object-fit: cover; box-shadow: 0 12px 28px rgba(0, 0, 0, 0.55); background: #222028; }
  .for-you-title { font-size: 14px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .for-you-sub { font-size: 12px; color: var(--md-on-surface-variant); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .library-screen-pad { padding: max(18px, env(safe-area-inset-top)) 16px 20px; }
  .lib-top-cards { display: flex; gap: 12px; overflow-x: auto; margin-bottom: 18px; scrollbar-width: none; }
  .lib-big-card { height: 122px; border-radius: 24px; padding: 18px; display: flex; flex-direction: column; justify-content: space-between; cursor: pointer; flex-shrink: 0; }
  .lib-big-card.red-fav { width: 268px; background: linear-gradient(135deg, #b71c1c 0%, #681616 100%); color: #ffffff; }
  .lib-big-card.grey-dl { width: 160px; background: linear-gradient(135deg, #d4d4d8 0%, #9ca3af 100%); color: #18181b; }
  .lib-filter-bar { display: flex; align-items: center; gap: 8px; overflow-x: auto; margin-bottom: 24px; scrollbar-width: none; }
  .lib-circle-btn {
    width: 44px; height: 44px; border-radius: 22px; border: 1px solid rgba(255, 255, 255, 0.08);
    background: #141417; color: #ffffff; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; cursor: pointer;
  }
  .lib-pill-btn {
    height: 42px; padding: 0 18px; border-radius: 21px; border: 1px solid rgba(255, 255, 255, 0.08);
    background: #141417; color: #ffffff; font-family: inherit; font-size: 14px; font-weight: 600; white-space: nowrap; cursor: pointer;
  }
  .lib-pill-btn.active { background: #ffffff; color: #000000; border-color: #ffffff; }

  .fav-detail-header { background: linear-gradient(180deg, #4b1519 0%, #240b0d 65%, var(--md-background) 100%); padding: max(16px, env(safe-area-inset-top)) 16px 18px; }
  .fav-top-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
  .fav-glass-btn { width: 44px; height: 44px; border-radius: 22px; border: none; background: rgba(255, 255, 255, 0.12); color: #ffffff; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; }
  .fav-hero-heart { display: flex; justify-content: center; margin: 12px 0 28px; }
  .fav-hero-heart .icon { font-size: 74px; color: #ff6b6b; }
  .fav-action-bar { display: flex; align-items: center; gap: 10px; margin-top: 16px; }
  .fav-play-all-btn { flex: 1; height: 52px; border-radius: 26px; border: none; background: #ffffff; color: #000000; font-family: inherit; font-size: 16px; font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 8px; cursor: pointer; }

  .clean-track-list { display: flex; flex-direction: column; gap: 6px; padding: 0 16px; }
  .clean-track-row { display: flex; align-items: center; padding: 8px 4px; border-radius: 14px; cursor: pointer; }
  .clean-track-row.playing { background: rgba(255, 255, 255, 0.08); }
  .clean-track-row.disabled-track { opacity: 0.55; }
  .clean-track-cover {
    width: 52px; height: 52px; border-radius: 12px; object-fit: cover;
    background: #222028; flex-shrink: 0; transition: opacity 0.2s;
  }
  .clean-track-info { flex: 1; min-width: 0; margin: 0 12px; }
  .clean-track-title { font-size: 15px; font-weight: 700; color: #ffffff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .clean-track-artist { font-size: 13px; color: #9e9aa4; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .clean-dur-pill { padding: 5px 11px; border-radius: 999px; background: #151518; border: 1px solid rgba(255, 255, 255, 0.06); font-size: 12px; font-weight: 600; color: #d4d4d8; flex-shrink: 0; }

  .search-screen-wrap { padding: max(18px, env(safe-area-inset-top)) 16px 20px; display: flex; flex-direction: column; min-height: calc(100dvh - 150px); justify-content: space-between; }
  .search-bottom-card { background: #141417; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 26px; padding: 8px 0; margin-top: 14px; box-shadow: 0 14px 40px rgba(0, 0, 0, 0.6); }
  .history-item-row { display: flex; align-items: center; justify-content: space-between; padding: 12px 18px; cursor: pointer; }
  .history-left { display: flex; align-items: center; gap: 14px; font-size: 15px; font-weight: 500; color: #ffffff; }
  .history-left .icon { color: #8e8e93; font-size: 20px; }
  .search-card-input-bar { display: flex; align-items: center; gap: 12px; padding: 10px 14px 6px 18px; border-top: 1px solid rgba(255, 255, 255, 0.06); }
  .search-card-input-bar input { flex: 1; background: transparent; border: none; color: #ffffff; font-size: 16px; font-family: inherit; outline: none; }
  .search-source-badge { width: 36px; height: 36px; border-radius: 18px; background: #261515; color: #ff4e45; display: flex; align-items: center; justify-content: center; }

  .profile-screen-pad { padding: max(18px, env(safe-area-inset-top)) 16px 24px; }
  .profile-top-card { background: #141417; border: 1px solid rgba(255, 255, 255, 0.07); border-radius: 26px; padding: 18px; margin-bottom: 20px; }
  .profile-user-row { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; }
  .user-id-meta-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-bottom: 14px; }
  .user-id-chip { background: #1b1b20; border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 16px; padding: 10px 12px; }
  .user-id-chip-lbl { font-size: 11px; color: #8e8e93; margin-bottom: 3px; }
  .user-id-chip-val { font-size: 13px; font-weight: 800; color: #ffffff; word-break: break-all; }

  .profile-share-btn { width: 100%; height: 48px; border-radius: 16px; border: none; background: #ffffff; color: #000000; font-family: inherit; font-size: 15px; font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 8px; cursor: pointer; }
  .profile-group-label { font-size: 13px; font-weight: 600; color: #8e8e93; margin: 4px 6px 8px; }
  .profile-menu-group { background: #141417; border: 1px solid rgba(255, 255, 255, 0.07); border-radius: 24px; overflow: hidden; margin-bottom: 20px; }
  .profile-menu-item { display: flex; align-items: center; justify-content: space-between; padding: 15px 18px; cursor: pointer; border-bottom: 1px solid rgba(255, 255, 255, 0.04); }
  .profile-menu-item:last-child { border-bottom: none; }
  .pm-left { display: flex; align-items: center; gap: 14px; font-size: 15px; font-weight: 600; color: #ffffff; }
  .pm-left .icon { color: #8e8e93; font-size: 21px; }
  .pm-right { display: flex; align-items: center; gap: 6px; color: #8e8e93; font-size: 14px; }

  .m3-switch { width: 46px; height: 26px; border-radius: 13px; background: #3f3f46; position: relative; cursor: pointer; transition: background 0.2s; }
  .m3-switch.on { background: var(--md-primary); }
  .m3-switch::after { content: ''; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: #ffffff; transition: transform 0.2s; }
  .m3-switch.on::after { transform: translateX(20px); }

  .session-item-row {
    padding: 12px 14px;
    border-radius: 14px;
    background: #1b1b20;
    border: 1px solid rgba(255, 255, 255, 0.06);
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  .stats-top-summary { background: #121215; border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 24px; padding: 20px 12px; display: grid; grid-template-columns: repeat(3, 1fr); text-align: center; margin-bottom: 12px; }
  .stat-big-val { font-size: 26px; font-weight: 800; color: #ffffff; }
  .stat-sub-lbl { font-size: 12px; color: #8e8e93; margin-top: 4px; }
  .stats-detail-box { background: #121215; border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 24px; padding: 18px 12px; margin-bottom: 22px; }
  .stats-grid-2x2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px 8px; text-align: center; padding-bottom: 16px; border-bottom: 1px solid rgba(255, 255, 255, 0.05); }
  .stats-bottom-single { text-align: center; padding-top: 14px; }
  .stats-artists-row { display: flex; gap: 14px; overflow-x: auto; padding-bottom: 8px; margin-bottom: 22px; scrollbar-width: none; }
  .stat-artist-item { width: 82px; flex-shrink: 0; text-align: center; cursor: pointer; }
