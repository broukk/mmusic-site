  function renderSearchResults(list) {
    document.getElementById("searchResultsList").innerHTML = renderTrackRowsHtml(list);
  }

  function quickSearchArtist(artistName) {
    switchTab("search");
    document.getElementById("searchInput").value = artistName;
    handleSearchInput(artistName);
  }

  function renderTrackRowsHtml(list) {
    if (!list.length) {
      return `<div style="color:#8e8e93;font-size:14px;text-align:center;padding:24px 0">Треки не найдены</div>`;
    }
    const activeId = currentQueue[currentIndex]?.id;
    return list.map((t) => {
      const restricted = t.embeddable === false;
      return `
        <div class="clean-track-row ${t.id === activeId ? "playing" : ""} ${restricted ? "disabled-track" : ""}" onclick="playSpecificTrack('${escapeHtml(t.id)}')">
          <img class="clean-track-cover" src="${t.cover || DEFAULT_COVER_SVG}" alt="" loading="lazy" onerror="this.onerror=null;this.src=DEFAULT_COVER_SVG">
          <div class="clean-track-info">
            <div class="clean-track-title">${escapeHtml(t.title)}</div>
            <div class="clean-track-artist">${escapeHtml(t.artist)} ${restricted ? "• Недоступно вне YouTube" : ""}</div>
          </div>
          <span class="clean-dur-pill">${fmtTime(t.durationSec)}</span>
        </div>
      `;
    }).join("");
