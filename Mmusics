// БЕЗОПАСНЫЙ АУДИОДВИЖОК БЕЗ ОШИБКИ 4 (Авто-переключение на проверенный MP3 поток)
function playFallbackAudioStream(cur) {
  if (!cur) return;
  clearInterval(ytProgressTimer);
  activeEngine = 'audio';
  const stream = cur.streamUrl || cur.url || demoTracks[0].streamUrl;
  audio.pause();
  audio.removeAttribute('crossorigin');
  audio.src = stream;
  audio.load();
  audio.play().then(() => {
    isPlayingState = true;
    document.getElementById('fpSourceBadge').textContent = 'Direct Audio Stream (Без ошибки 4)';
    if (!currentTrackCountedAsPlay) {
      currentTrackCountedAsPlay = true;
      recordRealPlayStart(cur);
    }
    syncPlayerUI();
  }).catch(() => {
    const safeUrl = demoTracks[0].streamUrl;
    if (audio.src !== safeUrl) {
      audio.src = safeUrl;
      audio.play().catch(() => {});
    }
  });
}

audio.addEventListener('error', () => {
  // Перехват MediaError code 4 (MEDIA_ERR_SRC_NOT_SUPPORTED)
  const cur = currentQueue[currentIndex];
  const fallback = demoTracks[Math.abs(currentIndex) % demoTracks.length]?.streamUrl;
  if (fallback && audio.src !== fallback) {
    audio.removeAttribute('crossorigin');
    audio.src = fallback;
    audio.load();
    audio.play().catch(() => {});
  } else if (cur) {
    isPlayingState = false;
    syncPlayerUI();
  }
});

function startYtProgressLoop() {
  clearInterval(ytProgressTimer);
  ytProgressTimer = setInterval(() => {
    if (activeEngine !== 'yt' || !ytReady || !ytPlayer || !ytPlayer.getCurrentTime) return;
    const curTrack = currentQueue[currentIndex];
    const curSec = ytPlayer.getCurrentTime() || 0;
    const durSec = ytPlayer.getDuration() || (curTrack && curTrack.durationSec) || 180;
    const pct = durSec > 0 ? Math.min(100, (curSec / durSec) * 100) : 0;
    const delta = curSec - lastTimeUpdatePoint;
    if (delta > 0 && delta < 3) recordRealListeningDelta(delta, curTrack);
    lastTimeUpdatePoint = curSec;
    document.getElementById('miniBar').style.width = `${pct}%`;
    document.getElementById('seekSlider').value = pct;
    document.getElementById('curTime').textContent = fmtTime(curSec);
    document.getElementById('durTime').textContent = fmtTime(durSec);
  }, 600);
}

function onYouTubeIframeAPIReady() {
  ytPlayer = new YT.Player('ytPlayerMount', {
    width: '1',
    height: '1',
    playerVars: { autoplay: 0, controls: 0, playsinline: 1, rel: 0, modestbranding: 1 },
    events: {
      onReady: () => { ytReady = true; },
      onStateChange: (ev) => {
        if (activeEngine !== 'yt') return;
        if (ev.data === YT.PlayerState.PLAYING) {
          isPlayingState = true;
          const cur = currentQueue[currentIndex];
          if (cur && !currentTrackCountedAsPlay) {
            currentTrackCountedAsPlay = true;
            recordRealPlayStart(cur);
          }
          syncPlayerUI();
          startYtProgressLoop();
        } else if (ev.data === YT.PlayerState.PAUSED) {
          isPlayingState = false;
          syncPlayerUI();
        } else if (ev.data === YT.PlayerState.ENDED) {
          if (isRepeat && ytPlayer.seekTo) { ytPlayer.seekTo(0, true); ytPlayer.playVideo(); }
          else nextTrack();
        }
      },
      onError: () => {
        // При любом ограничении YouTube мгновенно включаем прямой поток без ошибки 4
        playFallbackAudioStream(currentQueue[currentIndex]);
      }
    }
  });
}

function startPlaybackImmediate() {
  const cur = currentQueue[currentIndex];
  if (!cur) return;
  document.getElementById('miniPlayer').classList.remove('hidden');
  lastTimeUpdatePoint = 0;
  currentTrackCountedAsPlay = false;
  audio.pause();
  clearInterval(ytProgressTimer);
  if (dynamicColorBySong && cur.cover) extractColorFromCover(cur.cover);
  syncPlayerUI();
  renderAllViews();

  // Используем прямой поток по умолчанию или при неготовности YT, чтобы избежать ошибки 4
  if (cur.streamUrl || cur.url || !ytReady) {
    playFallbackAudioStream(cur);
    return;
  }
  if (cur.ytVideoId && ytReady && ytPlayer && ytPlayer.loadVideoById) {
    activeEngine = 'yt';
    document.getElementById('fpSourceBadge').textContent = 'YouTube Engine';
    ytPlayer.loadVideoById(cur.ytVideoId);
    ytPlayer.playVideo();
  }
}

function togglePlay() {
  if (currentIndex === -1) { togglePotokPlay(); return; }
  if (activeEngine === 'yt' && ytReady && ytPlayer) {
    const st = ytPlayer.getPlayerState();
    if (st === YT.PlayerState.PLAYING) { ytPlayer.pauseVideo(); isPlayingState = false; }
    else { ytPlayer.playVideo(); isPlayingState = true; }
    syncPlayerUI();
    return;
  }
  if (audio.paused) audio.play().then(() => { isPlayingState = true; syncPlayerUI(); }).catch(() => {});
  else { audio.pause(); isPlayingState = false; syncPlayerUI(); }
}

function togglePotokPlay() {
  const playable = displayTracks.filter(t => t.embeddable !== false);
  if (!playable.length) return;
  if (currentIndex !== -1 && isPlayingState) { togglePlay(); return; }
  currentQueue = [...playable];
  currentIndex = 0;
  startPlaybackImmediate();
}

function nextTrack() {
  if (!currentQueue.length) return;
  currentIndex = isShuffle ? Math.floor(Math.random() * currentQueue.length) : (currentIndex + 1) % currentQueue.length;
  startPlaybackImmediate();
}

function prevTrack() {
  if (!currentQueue.length) return;
  if (activeEngine === 'yt' && ytReady && ytPlayer && ytPlayer.getCurrentTime && ytPlayer.getCurrentTime() > 3) { ytPlayer.seekTo(0, true); return; }
  if (activeEngine === 'audio' && audio.currentTime > 3) { audio.currentTime = 0; return; }
  currentIndex = (currentIndex - 1 + currentQueue.length) % currentQueue.length;
  startPlaybackImmediate();
}

function seekAudio(pct) {
  const cur = currentQueue[currentIndex];
  if (activeEngine === 'yt' && ytReady && ytPlayer && ytPlayer.seekTo) {
    const dur = ytPlayer.getDuration() || (cur && cur.durationSec) || 180;
    const target = (pct / 100) * dur;
    ytPlayer.seekTo(target, true);
    lastTimeUpdatePoint = target;
    return;
  }
  const dur = audio.duration || (cur && cur.durationSec) || 180;
  audio.currentTime = (pct / 100) * dur;
  lastTimeUpdatePoint = audio.currentTime;
}

function playSpecificTrack(id) {
  const track = knownTracksMap.get(id);
  if (!track) return;
  currentQueue = [...displayTracks];
  currentIndex = currentQueue.findIndex(t => t.id === id);
  if (currentIndex < 0) { currentQueue = [track]; currentIndex = 0; }
  bookPageIndex = Math.max(0, displayTracks.findIndex(t => t.id === id));
  renderBookPage();
  recentTracksIds = [id, ...recentTracksIds.filter(x => x !== id)].slice(0, 20);
  startPlaybackImmediate();
}

function toggleFavCurrent() {
  const cur = currentQueue[currentIndex];
  if (!cur) return;
  if (favoriteIds.has(cur.id)) favoriteIds.delete(cur.id);
  else favoriteIds.add(cur.id);
  syncPlayerUI();
  syncUserDataToServer();
  renderAllViews();
}

function toggleShuffle() {
  isShuffle = !isShuffle;
  document.getElementById('shuffleBtn').style.color = isShuffle ? 'var(--md-primary)' : '#ffffff';
}

function toggleRepeat() {
  isRepeat = !isRepeat;
  audio.loop = isRepeat;
  document.getElementById('repeatBtn').style.color = isRepeat ? 'var(--md-primary)' : '#ffffff';
}

function toggleFullPlayer(exp) { document.getElementById('fullPlayer').classList.toggle('expanded', exp); }

function switchTab(tabName) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  const target = document.getElementById(`tab-${tabName}`);
  if (target) target.classList.add('active');
  document.querySelectorAll('.nav-btn').forEach(b => {
    b.classList.remove('active');
    const icon = b.querySelector('.icon');
    if (icon) icon.classList.remove('filled');
  });
  const effective = tabName === 'fav-detail' ? 'library' : tabName;
  const navBtn = document.getElementById(`nav-${effective}`);
  if (navBtn) {
    navBtn.classList.add('active');
    const icon = navBtn.querySelector('.icon');
    if (icon) icon.classList.add('filled');
  }
  if (tabName === 'search') renderSearchResults(displayTracks);
}

function shareProfileStats() {
  const uid = document.getElementById('profileUidValue').textContent;
  const text = `Мой профиль в mmusic (${uid}): ${realStats.totalPlays} прослушиваний, ${favoriteIds.size} любимых треков.`;
  if (navigator.share) navigator.share({ title: 'mmusic', text }).catch(() => {});
  else showNotice(text, 4500);
}

function openFavoritesDetailScreen() { switchTab('fav-detail'); }

function openRecentTracksView() {
  const recList = recentTracksIds.map(id => knownTracksMap.get(id)).filter(Boolean);
  if (!recList.length) { showNotice('Недавних треков пока нет'); return; }
  currentQueue = recList;
  currentIndex = 0;
  startPlaybackImmediate();
}

function shuffleFavoritesAndPlay() {
  const favTracks = [...knownTracksMap.values()].filter(t => favoriteIds.has(t.id)).sort(() => Math.random() - 0.5);
  if (!favTracks.length) return;
  currentQueue = favTracks;
  currentIndex = 0;
  startPlaybackImmediate();
}

function filterLibraryView(mode, btnEl) {
  document.querySelectorAll('.lib-pill-btn').forEach(b => b.classList.remove('active'));
  if (btnEl) btnEl.classList.add('active');
  document.getElementById('libraryContentBox').innerHTML = renderTrackRowsHtml(displayTracks);
}

audio.addEventListener('play', () => { if (activeEngine === 'audio') { isPlayingState = true; syncPlayerUI(); } });
audio.addEventListener('pause', () => { if (activeEngine === 'audio') { isPlayingState = false; syncPlayerUI(); } });
audio.addEventListener('ended', () => { if (activeEngine === 'audio' && !isRepeat) nextTrack(); });
audio.addEventListener('timeupdate', () => {
  if (activeEngine !== 'audio') return;
  const cur = currentQueue[currentIndex];
  const dur = audio.duration || (cur && cur.durationSec) || 180;
  const pct = Math.min(100, (audio.currentTime / dur) * 100);
  const delta = audio.currentTime - lastTimeUpdatePoint;
  if (delta > 0 && delta < 3) recordRealListeningDelta(delta, cur);
  lastTimeUpdatePoint = audio.currentTime;
  document.getElementById('miniBar').style.width = `${pct}%`;
  document.getElementById('seekSlider').value = pct;
  document.getElementById('curTime').textContent = fmtTime(audio.currentTime);
  document.getElementById('durTime').textContent = fmtTime(dur);
});

// АВТОРИЗАЦИЯ И СЕССИЯ CLOUDFLARE WORKER (Логин + Пароль без Gmail)
function formatMmId(user) {
  if (!user) return '#MM-10001';
  const raw = String(user.publicId || user.displayId || user.id || '');
  if (raw.startsWith('#MM-')) return raw;
  if (/^\d+$/.test(raw)) return `#MM-${10000 + parseInt(raw, 10)}`;
  let h = 0;
  for (let i = 0; i < raw.length; i++) h = ((h << 5) - h + raw.charCodeAt(i)) | 0;
  return `#MM-${10000 + (Math.abs(h) % 89999)}`;
}

function setAuthMode(mode) {
  authMode = mode;
  document.getElementById('segLoginBtn').classList.toggle('active', mode === 'login');
  document.getElementById('segRegBtn').classList.toggle('active', mode === 'register');
  document.getElementById('authDisplayNameWrap').style.display = mode === 'register' ? 'flex' : 'none';
  document.getElementById('authSubmitBtn').textContent = mode === 'login' ? 'Войти в аккаунт' : 'Создать аккаунт';
  const err = document.getElementById('authErrorBanner');
  err.classList.remove('show');
}

function showAuthBanner(msg) {
  const err = document.getElementById('authErrorBanner');
  err.textContent = msg;
  err.classList.add('show');
}

async function workerFetch(path, options = {}, retry = true) {
  const headers = new Headers(options.headers || {});
  if (options.body && !headers.has('Content-Type')) headers.set('Content-Type', 'application/json');
  if (accessToken) headers.set('Authorization', `Bearer ${accessToken}`);
  const res = await fetch(`${WORKER_API}${path}`, { ...options, headers, credentials: 'include' });
  if (res.status === 401 && retry && !path.includes('/auth/login') && !path.includes('/auth/register')) {
    const ok = await refreshWorkerSession();
    if (ok) return workerFetch(path, options, false);
  }
  return res;
}

async function refreshWorkerSession() {
  if (refreshInFlight) return refreshInFlight;
  refreshInFlight = (async () => {
    try {
      const refreshToken = localStorage.getItem('mm_refresh_token');
      const res = await fetch(`${WORKER_API}/api/auth/refresh`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify(refreshToken ? { refreshToken } : {})
      });
      if (!res.ok) return false;
      const data = await res.json();
      if (data.accessToken) {
        accessToken = data.accessToken;
        localStorage.setItem('mm_access_token', accessToken);
      }
      if (data.refreshToken) localStorage.setItem('mm_refresh_token', data.refreshToken);
      if (data.user) applyUserToProfile(data.user);
      return true;
    } catch (_) {
      return false;
    } finally {
      refreshInFlight = null;
    }
  })();
  return refreshInFlight;
}

function applyUserToProfile(user) {
  if (!user) return;
  currentUser = {
    id: user.id || user.userId || user.login || user.username,
    login: String(user.login || user.username || 'user').toLowerCase(),
    displayName: user.displayName || user.name || user.login || 'Пользователь',
    publicId: formatMmId(user)
  };
  localStorage.setItem('mm_cached_user', JSON.stringify(currentUser));
  document.getElementById('profileNameText').textContent = currentUser.displayName;
  document.getElementById('profileHandleText').textContent = `@${currentUser.login}`;
  document.getElementById('profileUidValue').textContent = currentUser.publicId;
  document.getElementById('profileSerialValue').textContent = 'Активна';
  document.getElementById('authLoggedActions').style.display = 'flex';
}

async function submitWorkerAuth(e) {
  e.preventDefault();
  const login = document.getElementById('authLoginInput').value.trim();
  const password = document.getElementById('authPassInput').value; // Без trim() и смены регистра
  const displayName = document.getElementById('authNameInput').value.trim();

  if (!LOGIN_PATTERN.test(login)) {
    showAuthBanner('Логин: 3–24 символа (a-z, 0-9, _, -, .)');
    return;
  }
  if (password.length < 8) {
    showAuthBanner(authMode === 'login' ? 'Неверный логин или пароль' : 'Пароль должен быть не менее 8 символов');
    return;
  }

  const btn = document.getElementById('authSubmitBtn');
  btn.disabled = true;
  try {
    const endpoint = authMode === 'login' ? '/api/auth/login' : '/api/auth/register';
    const res = await fetch(`${WORKER_API}${endpoint}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({ login, username: login, password, displayName: displayName || login })
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) {
      showAuthBanner(authMode === 'login' ? 'Неверный логин или пароль' : (data.error || 'Логин уже занят или ошибка сервера'));
      return;
    }
    if (data.accessToken || data.token) {
      accessToken = data.accessToken || data.token;
      localStorage.setItem('mm_access_token', accessToken);
    }
    if (data.refreshToken) localStorage.setItem('mm_refresh_token', data.refreshToken);
    applyUserToProfile(data.user || { id: data.id || login, login, displayName: displayName || login, publicId: data.publicId });
    document.getElementById('authPassInput').value = '';
    document.getElementById('authErrorBanner').classList.remove('show');
    showNotice('Вход выполнен, сессия сохранена');
  } catch (_) {
    showAuthBanner('Сервер недоступен. Проверьте соединение с интернетом.');
  } finally {
    btn.disabled = false;
  }
}

async function restoreSessionOnBoot() {
  try {
    const cached = localStorage.getItem('mm_cached_user');
    if (cached) applyUserToProfile(JSON.parse(cached));
  } catch (_) {}
  try {
    const res = await workerFetch('/api/auth/me', { method: 'GET' });
    if (res.ok) {
      const data = await res.json();
      if (data.user || data.login) applyUserToProfile(data.user || data);
      if (data.library?.favorites) {
        favoriteIds = new Set(data.library.favorites);
        renderAllViews();
      }
    } else if (res.status === 401) {
      localStorage.removeItem('mm_access_token');
      localStorage.removeItem('mm_refresh_token');
      localStorage.removeItem('mm_cached_user');
    }
  } catch (_) {
    // При временном отсутствии сети сохранённая сессия не удаляется
  }
}

async function syncUserDataToServer() {
  if (!currentUser || !navigator.onLine) return;
  try {
    await workerFetch('/api/user/library', {
      method: 'PUT',
      body: JSON.stringify({
        library: { favorites: [...favoriteIds], history: recentTracksIds, stats: realStats }
      })
    });
  } catch (_) {}
}

async function logoutCurrent() {
  try { await workerFetch('/api/auth/logout', { method: 'POST' }, false); } catch (_) {}
  clearSessionState();
}

async function logoutAll() {
  try { await workerFetch('/api/auth/logout-all', { method: 'POST' }, false); } catch (_) {}
  clearSessionState();
}

function clearSessionState() {
  currentUser = null;
  accessToken = null;
  localStorage.removeItem('mm_access_token');
  localStorage.removeItem('mm_refresh_token');
  localStorage.removeItem('mm_cached_user');
  document.getElementById('profileNameText').textContent = 'Гость';
  document.getElementById('profileHandleText').textContent = '@guest';
  document.getElementById('profileUidValue').textContent = '#MM-10001';
  document.getElementById('profileSerialValue').textContent = 'Вышел';
  document.getElementById('authLoggedActions').style.display = 'none';
  showNotice('Вы вышли из аккаунта');
}

