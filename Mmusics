    <button class="nav-item rubber-btn" onclick="switchTab(2)" aria-label="Профиль"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg></button>
  </nav>

  <!-- БОЛЬШОЙ ПЛЕЕР (PIXEL 9 SQUIGGLY LINE) -->
  <div class="full-player" id="fullPlayer">
    <div style="display:flex;justify-content:space-between;align-items:center;">
      <button class="icon-btn rubber-btn" onclick="closeFullPlayer()"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m6 9 6 6 6-6"/></svg></button>
      <span style="font-weight:800;font-size:14px;color:var(--on-surface-var)">mmusic</span>
      <button class="icon-btn rubber-btn" onclick="downloadCurrentTrack()"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg></button>
    </div>

    <div class="fp-book-stage" id="fpSwipeStage">
      <div class="fp-spread-card">
        <div class="md3-page-left"><div class="md3-page-emboss">m</div></div>
        <div class="md3-page-right">
          <div>
            <div class="md3-book-song" id="fpBookSongTitle">Первый луч</div>
            <div class="md3-book-artist" id="fpBookSongArtist">Aether Line</div>
          </div>
          <div class="md3-page-emboss" style="opacity:0.35">m</div>
        </div>
      </div>
    </div>

    <div class="squiggly-player-wrap" id="fpSquigglyWrap" onpointerdown="startPlayerSquigglyDrag(event)">
      <canvas class="squiggly-canvas" id="fpSquigglyCanvas"></canvas>
      <div style="display:flex;justify-content:space-between;font-size:12px;color:var(--on-surface-var);margin-top:4px;">
        <span id="fpTimeCur">0:00</span>
        <span id="fpTimeTotal">3:25</span>
      </div>
    </div>

    <div style="display:flex;align-items:center;justify-content:space-between;">
      <button class="icon-btn rubber-btn" id="fpFavBtn" onclick="toggleFavoriteCurrent()"><svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg></button>
      <button class="icon-btn rubber-btn" style="width:56px;height:56px;border-radius:28px;" onclick="prevTrack(-1)"><svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zm3.5 6 8.5 6V6z"/></svg></button>
      <button class="md3-play-fab rubber-btn" onclick="togglePlay()"><svg id="fpPlayIcon" width="34" height="34" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button>
      <button class="icon-btn rubber-btn" style="width:56px;height:56px;border-radius:28px;" onclick="nextTrack(1)"><svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="m6 18 8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg></button>
      <button class="icon-btn rubber-btn" onclick="downloadCurrentTrack()"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg></button>
    </div>
  </div>
</div>

<script>
// --- РЕАЛЬНЫЕ КАТАЛОГИ И ЯНДЕКС МУЗЫКА ---
const CATALOG = {
  albums: [
    { id: 'alb1', title: 'Тихие формы', artist: 'Klang & Свет', year: 2026, hue: 26, secHue: 345 },
    { id: 'alb2', title: 'Геометрия утра', artist: 'Aether Line', year: 2025, hue: 204, secHue: 265 },
    { id: 'alb3', title: 'Монолит и воздух', artist: 'Северный Круг', year: 2026, hue: 156, secHue: 205 },
    { id: 'alb4', title: 'Тепловые волны', artist: 'Solis', year: 2024, hue: 335, secHue: 25 }
  ],
  tracks: [
    { id: 'tr1', title: 'Первый луч', artist: 'Aether Line', duration: 164, hue: 26, secHue: 345 },
    { id: 'tr2', title: 'Параллели', artist: 'Aether Line', duration: 198, hue: 204, secHue: 265 },
    { id: 'tr3', title: 'Отражение в воде', artist: 'Klang & Свет', duration: 215, hue: 156, secHue: 205 },
    { id: 'tr4', title: 'Белый берег', artist: 'Северный Круг', duration: 240, hue: 95, secHue: 160 },
    { id: 'tr5', title: 'Южный ветер', artist: 'Solis', duration: 205, hue: 275, secHue: 330 }
  ]
};

const state = {
  activeTab: 0,
  isPlaying: false,
  isBookOpen: false,
  progress: 0.15,
  waveAmp: 0,
  animTime: 0,
  isDraggingProgress: false,
  progressDragOvershoot: 0,
  currentTrack: CATALOG.tracks[0],
  favorites: new Set(['tr1']),
  downloaded: new Set(),
  autoDownload: true
};

function drawSquigglyBar(canvas, fraction, waveAmp, phase, isDragging, overshootPx) {
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  const w = canvas.clientWidth, h = canvas.clientHeight;
  if (canvas.width !== w * dpr) { canvas.width = w * dpr; canvas.height = h * dpr; }
  ctx.save();
  ctx.scale(dpr, dpr);
  ctx.clearRect(0, 0, w, h);

  const pad = 12, cy = h / 2, activeX = pad + (w - pad * 2) * Math.min(1, Math.max(0, fraction));
  ctx.strokeStyle = 'rgba(255, 255, 255, 0.18)';
  ctx.lineWidth = 4;
  ctx.lineCap = 'round';
  ctx.beginPath();
  ctx.moveTo(Math.min(w - pad, activeX + 8), cy);
  ctx.lineTo(w - pad, cy);
  ctx.stroke();

  ctx.strokeStyle = 'hsl(var(--hue), 78%, 74%)';
  ctx.lineWidth = isDragging ? 5.5 : 4;
  ctx.beginPath();
  const amp = 4.2 * waveAmp;
  for (let x = pad; x <= activeX; x += 3) {
    const y = cy + Math.sin((x - pad) / 24 * Math.PI * 2 - phase * 3) * amp;
    if (x === pad) ctx.moveTo(x, y); else ctx.lineTo(x, y);
  }
  ctx.stroke();
  ctx.restore();
}

function renderLoop(now) {
  if (state.isPlaying && !state.isDraggingProgress) {
    state.animTime += 0.05;
    state.waveAmp += (1 - state.waveAmp) * 0.12;
  } else {
    state.waveAmp += (0 - state.waveAmp) * 0.12;
  }
  drawSquigglyBar(document.getElementById('fpSquigglyCanvas'), state.progress, state.waveAmp, state.animTime, state.isDraggingProgress, state.progressDragOvershoot);
  requestAnimationFrame(renderLoop);
}
requestAnimationFrame(renderLoop);

function toggleBookOpenAndPlay() {
  state.isBookOpen = !state.isBookOpen;
  state.isPlaying = state.isBookOpen;
  document.getElementById('md3Book').classList.toggle('open', state.isBookOpen);
  document.getElementById('md3Book').classList.toggle('playing', state.isPlaying);
  updateUI();
}

function togglePlay() {
  if (!state.isBookOpen) { toggleBookOpenAndPlay(); return; }
  state.isPlaying = !state.isPlaying;
  document.getElementById('md3Book').classList.toggle('playing', state.isPlaying);
  updateUI();
}

function openFullPlayer() { document.getElementById('fullPlayer').classList.add('open'); }
function closeFullPlayer() { document.getElementById('fullPlayer').classList.remove('open'); }
function switchTab(idx) {
  state.activeTab = idx;
  document.querySelectorAll('.tab-screen').forEach((s, i) => s.classList.toggle('active', i === idx));
  document.querySelectorAll('.nav-item').forEach((b, i) => b.classList.toggle('active', i === idx));
  document.getElementById('bottomNavBar').style.setProperty('--nav-idx', idx);
}

function updateUI() {
  const t = state.currentTrack;
  document.getElementById('bookSongTitle').textContent = t.title;
  document.getElementById('bookSongArtist').textContent = t.artist;
  document.getElementById('fpBookSongTitle').textContent = t.title;
  document.getElementById('fpBookSongArtist').textContent = t.artist;
  document.getElementById('miniTitle').textContent = t.title;
  document.getElementById('miniArtist').textContent = t.artist;
  document.documentElement.style.setProperty('--hue', t.hue);
  document.documentElement.style.setProperty('--sec-hue', t.secHue);
}

function startPlayerSquigglyDrag(e) {
  const wrap = document.getElementById('fpSquigglyWrap');
  const rect = wrap.getBoundingClientRect();
  state.isDraggingProgress = true;
  const update = (clientX) => {
    const raw = (clientX - rect.left - 12) / (rect.width - 24);
    state.progress = Math.min(1, Math.max(0, raw));
  };
  update(e.clientX);
  const onMove = (ev) => update(ev.clientX);
  const onUp = () => {
    state.isDraggingProgress = false;
    window.removeEventListener('pointermove', onMove);
    window.removeEventListener('pointerup', onUp);
  };
  window.addEventListener('pointermove', onMove);
  window.addEventListener('pointerup', onUp);
}

window.addEventListener('DOMContentLoaded', () => {
  updateUI();
});
</script>
