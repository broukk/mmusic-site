  document.getElementById('favHomeCountLabel').textContent = `${favTracks.length} треков`;
  document.getElementById('libFavCountText').textContent = `${favTracks.length} треков`;
  document.getElementById('profileTrackCount').textContent = `${displayTracks.length}`;
  document.getElementById('profileStatPreview').textContent = `${realStats.totalPlays}`;
  document.getElementById('bookStatPlays').textContent = `${realStats.totalPlays}`;
  document.getElementById('bookStatFavs').textContent = `${favTracks.length}`;

  bindCoverImage(document.getElementById('recentShortcutImg'), recTracks[0]?.cover || displayTracks[0]?.cover);
  bindCoverImage(document.getElementById('favShortcutImg'), favTracks[0]?.cover || displayTracks[1]?.cover);

  const forYouEl = document.getElementById('forYouRow');
  const picks = displayTracks.slice(0, 6);
  forYouEl.innerHTML = picks.map((t, i) => {
    const prevCov = picks[(i + 1) % picks.length]?.cover || t.cover || DEFAULT_COVER_SVG;
    const nextCov = picks[(i + 2) % picks.length]?.cover || t.cover || DEFAULT_COVER_SVG;
    const mainCov = t.cover || DEFAULT_COVER_SVG;
    return `
      <div class="for-you-card" onclick="playSpecificTrack('${escapeHtml(t.id)}')">
        <div class="for-you-art-stack">
          <img class="stack-side-img left" src="${prevCov}" alt="" onerror="this.onerror=null;this.src=DEFAULT_COVER_SVG">
          <img class="stack-side-img right" src="${nextCov}" alt="" onerror="this.onerror=null;this.src=DEFAULT_COVER_SVG">
          <img class="stack-main-img" src="${mainCov}" alt="" onerror="this.onerror=null;this.src=DEFAULT_COVER_SVG">
        </div>
        <div class="for-you-title">${escapeHtml(t.title)}</div>
        <div class="for-you-sub">${escapeHtml(t.artist)}</div>
      </div>
    `;
  }).join('');

  document.getElementById('homeTrackList').innerHTML = renderTrackRowsHtml(displayTracks);
  document.getElementById('bookFullList').innerHTML = renderTrackRowsHtml(displayTracks);
  document.getElementById('favDetailTrackList').innerHTML = renderTrackRowsHtml(favTracks);
  document.getElementById('libraryContentBox').innerHTML = renderTrackRowsHtml(displayTracks.slice(0, 15));
  renderBookPage();
  renderSearchHistory();
  renderSearchResults(displayTracks);
  if (currentQueue[currentIndex]) syncPlayerUI();
}

registerTracks(demoTracks);
