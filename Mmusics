      <div class="profile-card glass-panel">
        <div style="display:flex;align-items:center;justify-content:space-between;padding:4px 0;">
          <span style="font-weight:700;font-size:14px;">Автоскачивание при лайке</span>
          <div class="capsule-toggle checked" id="synthCapsuleSwitch" onclick="toggleAutoDownloadSetting()"><div class="capsule-toggle-knob"></div></div>
        </div>
        <div style="display:flex;align-items:center;justify-content:space-between;padding:10px 0 2px;">
          <span style="font-weight:700;font-size:14px;">Цвет книги по треку</span>
