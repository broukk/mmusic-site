  <!-- НИЖНЯЯ ПАНЕЛЬ -->
  <nav class="bottom-nav glass-panel" id="bottomNavBar" style="--nav-idx:0;">
    <div class="nav-pill-bg"></div>
    <button class="nav-item active rubber-btn" onclick="switchTab(0)" aria-label="Главная"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg></button>
