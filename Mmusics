<!DOCTYPE html>
<html lang="ru" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>mmusic — Material 3</title>
<style>
  :root {
    --hue: 26;
    --sec-hue: 346;
    --book-hue: 26;
    --glass-blur: 14px;
    --glass-alpha: 0.84;
    --glass-stroke: 0.10;

    --spring-rubber: cubic-bezier(0.20, 1.38, 0.34, 1);
    --spring-book: cubic-bezier(0.22, 1.22, 0.36, 1);
    --spring-swipe: cubic-bezier(0.18, 1.20, 0.32, 1);
    --color-trans: 360ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* ТЁМНАЯ ТЕМА MD3 */
  html[data-theme="dark"] {
    --bg: hsl(var(--hue), 16%, 7%);
    --on-bg: hsl(var(--hue), 20%, 95%);
    --surface: hsla(var(--hue), 16%, 11%, var(--glass-alpha));
    --surface-container: hsla(var(--hue), 16%, 14%, var(--glass-alpha));
    --surface-high: hsla(var(--hue), 18%, 19%, var(--glass-alpha));
    --surface-highest: hsla(var(--hue), 18%, 25%, var(--glass-alpha));
    --on-surface: hsl(var(--hue), 18%, 94%);
    --on-surface-var: hsl(var(--hue), 14%, 66%);
    --primary: hsl(var(--hue), 78%, 74%);
    --on-primary: hsl(var(--hue), 72%, 13%);
    --primary-container: hsl(var(--hue), 48%, 24%);
    --on-primary-container: hsl(var(--hue), 85%, 92%);
    --secondary-container: hsl(var(--sec-hue), 34%, 22%);
    --on-secondary-container: hsl(var(--sec-hue), 75%, 90%);
    --outline-var: hsla(var(--hue), 25%, 88%, var(--glass-stroke));
    --outer-backdrop: #050404;

    /* Палитра минималистичной книги MD3 */
    --book-cover-bg: linear-gradient(145deg, hsl(var(--book-hue), 54%, 28%), hsl(var(--book-hue), 48%, 16%));
    --book-left-bg: linear-gradient(135deg, hsl(var(--book-hue), 52%, 27%), hsl(var(--book-hue), 46%, 18%));
    --book-right-bg: linear-gradient(225deg, hsl(var(--book-hue), 20%, 19%), hsl(var(--book-hue), 18%, 13%));
    --book-title-color: hsl(var(--book-hue), 30%, 95%);
    --book-artist-color: hsla(var(--book-hue), 25%, 80%, 0.72);
    --book-emboss: hsla(var(--book-hue), 35%, 8%, 0.55);
    --book-emboss-hi: hsla(var(--book-hue), 80%, 75%, 0.14);
    --book-border: hsla(var(--book-hue), 45%, 65%, 0.18);
  }

  /* СВЕТЛАЯ ТЕМА MD3 */
  html[data-theme="light"] {
    --bg: hsl(var(--hue), 30%, 96%);
    --on-bg: hsl(var(--hue), 32%, 11%);
    --surface: hsla(var(--hue), 30%, 99%, var(--glass-alpha));
    --surface-container: hsla(var(--hue), 26%, 92%, var(--glass-alpha));
    --surface-high: hsla(var(--hue), 24%, 87%, var(--glass-alpha));
    --surface-highest: hsla(var(--hue), 22%, 80%, var(--glass-alpha));
    --on-surface: hsl(var(--hue), 32%, 12%);
    --on-surface-var: hsl(var(--hue), 18%, 38%);
    --primary: hsl(var(--hue), 66%, 38%);
    --on-primary: #ffffff;
    --primary-container: hsl(var(--hue), 72%, 86%);
    --on-primary-container: hsl(var(--hue), 72%, 14%);
    --secondary-container: hsl(var(--sec-hue), 56%, 87%);
    --on-secondary-container: hsl(var(--sec-hue), 60%, 16%);
    --outline-var: hsla(var(--hue), 30%, 18%, var(--glass-stroke));
    --outer-backdrop: hsl(var(--hue), 20%, 88%);

    /* Палитра книги в светлой теме MD3 */
    --book-cover-bg: linear-gradient(145deg, hsl(var(--book-hue), 60%, 44%), hsl(var(--book-hue), 54%, 32%));
    --book-left-bg: linear-gradient(135deg, hsl(var(--book-hue), 58%, 46%), hsl(var(--book-hue), 52%, 35%));
    --book-right-bg: linear-gradient(225deg, hsl(var(--book-hue), 32%, 89%), hsl(var(--book-hue), 26%, 82%));
    --book-title-color: hsl(var(--book-hue), 42%, 13%);
    --book-artist-color: hsla(var(--book-hue), 30%, 26%, 0.72);
    --book-emboss: hsla(var(--book-hue), 45%, 18%, 0.42);
    --book-emboss-hi: rgba(255, 255, 255, 0.35);
    --book-border: hsla(var(--book-hue), 40%, 30%, 0.16);
  }

  body.reduced-motion * {
    --spring-rubber: cubic-bezier(0.4, 0, 0.2, 1) !important;
    --spring-book: cubic-bezier(0.4, 0, 0.2, 1) !important;
    --spring-swipe: cubic-bezier(0.4, 0, 0.2, 1) !important;
    transition-duration: 140ms !important;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }

  body {
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    background: var(--outer-backdrop);
    color: var(--on-bg);
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    overflow: hidden;
  }

  .device-frame {
    position: relative;
    width: 100%;
    max-width: 430px;
    height: 100vh;
    max-height: 920px;
    background: var(--bg);
    color: var(--on-bg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: background var(--color-trans), color var(--color-trans);
  }

  @media (min-width: 460px) {
    .device-frame {
      height: 93vh;
      border-radius: 46px;
      border: 4px solid var(--outline-var);
      box-shadow: 0 20px 60px rgba(0,0,0,0.42);
    }
  }

  .glass-panel {
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--outline-var);
  }

  .rubber-btn {
    cursor: pointer;
    transition: transform 340ms var(--spring-rubber), background 240ms ease, color 240ms ease;
  }
  .rubber-btn:active {
    transform: scale(0.92);
  }

  /* ВЕРХНЯЯ ПАНЕЛЬ MD3 */
  .top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px 8px;
    height: 64px;
    z-index: 5;
  }
  .brand-row {
    display: flex;
    align-items: center;
    gap: 10px;
    transition: opacity 200ms, transform 320ms var(--spring-book);
  }
  .brand-row.hidden {
    opacity: 0;
    transform: translateX(-16px) scale(0.92);
    pointer-events: none;
    width: 0;
    overflow: hidden;
  }
  .brand-title {
    font-size: 23px;
    font-weight: 900;
    letter-spacing: -0.7px;
  }
  .top-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    justify-content: flex-end;
  }
  .search-shell {
    height: 44px;
    width: 44px;
    border-radius: 22px;
    background: var(--surface-high);
    color: var(--on-surface);
    display: flex;
    align-items: center;
    padding: 0 11px;
    overflow: hidden;
    transition: width 420ms var(--spring-book);
  }
  .search-shell.expanded {
    width: 100%;
  }
  .search-input {
    border: none;
    background: transparent;
    color: var(--on-surface);
    font-size: 15px;
    width: 100%;
    margin-left: 8px;
    outline: none;
    display: none;
  }
  .search-shell.expanded .search-input {
    display: block;
  }
  .icon-btn {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    border: none;
    background: var(--surface-high);
    color: var(--on-surface);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* ВКЛАДКИ */
  .screens-viewport {
    flex: 1;
    position: relative;
    overflow: hidden;
  }
  .tab-screen {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 4px 20px 24px;
    opacity: 0;
    pointer-events: none;
    transform: translateY(12px);
    transition: opacity 240ms ease, transform 400ms var(--spring-book);
  }
  .tab-screen::-webkit-scrollbar { display: none; }
  .tab-screen.active {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  /* МИНИМАЛИСТИЧНАЯ КНИГА MD3 */
  .md3-book-stage {
    position: relative;
    width: 100%;
    height: 268px;
    margin: 4px 0 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1400px;
    touch-action: pan-y;
  }
  .md3-book {
    position: relative;
    width: 168px;
    height: 220px;
    cursor: pointer;
    transform-style: preserve-3d;
    transition: width 620ms var(--spring-book), transform 520ms var(--spring-rubber), box-shadow 520ms ease;
    will-change: width, transform;
  }
  .md3-book:active { transform: scale(0.96); }
  .md3-book.open { width: 344px; }
  .md3-book-spread {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-radius: 28px;
    overflow: hidden;
    border: 1px solid var(--book-border);
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.34);
    opacity: 0;
    transform: scale(0.94);
    transition: opacity 380ms ease, transform 620ms var(--spring-book);
  }
  .md3-book.open .md3-book-spread {
    opacity: 1;
    transform: scale(1);
  }
  .md3-page-left {
    position: relative;
    background: var(--book-left-bg);
    padding: 22px 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-right: 1px solid rgba(0, 0, 0, 0.22);
    box-shadow: inset -12px 0 20px rgba(0, 0, 0, 0.16);
    transition: background var(--color-trans);
  }
  .md3-page-right {
    position: relative;
    background: var(--book-right-bg);
    padding: 22px 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: inset 12px 0 20px rgba(0, 0, 0, 0.14);
    transition: background var(--color-trans);
  }
  .md3-page-emboss {
    font-size: 56px;
    font-weight: 900;
    letter-spacing: -3px;
    line-height: 1;
    color: var(--book-emboss);
    text-shadow: 1px 1px 0 var(--book-emboss-hi);
    align-self: center;
    margin: auto 0;
    pointer-events: none;
  }
  .md3-sound-bars {
    display: inline-flex;
    align-items: flex-end;
    gap: 4px;
    height: 16px;
  }
  .md3-sound-bars span {
    width: 4px;
    height: 6px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.78);
    transition: height 200ms ease;
  }
  .md3-book.open.playing .md3-sound-bars span:nth-child(1) { animation: eqPulse 720ms ease-in-out infinite alternate; }
  .md3-book.open.playing .md3-sound-bars span:nth-child(2) { animation: eqPulse 540ms ease-in-out 120ms infinite alternate; }
  .md3-book.open.playing .md3-sound-bars span:nth-child(3) { animation: eqPulse 660ms ease-in-out 240ms infinite alternate; }
  @keyframes eqPulse {
    0% { height: 5px; opacity: 0.55; }
    100% { height: 16px; opacity: 1; }
  }

  .md3-book-song {
    font-size: 18px;
    font-weight: 900;
    letter-spacing: -0.4px;
    line-height: 1.22;
    color: var(--book-title-color);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color var(--color-trans);
  }
  .md3-book-artist {
    font-size: 13px;
    font-weight: 700;
    color: var(--book-artist-color);
    margin-top: 6px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color var(--color-trans);
  }
  .md3-book-page-num {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.5px;
    color: var(--book-artist-color);
    align-self: flex-end;
  }
  .md3-book-cover {
    position: absolute;
    inset: 0;
    border-radius: 12px 28px 28px 12px;
    background: var(--book-cover-bg);
    border: 1px solid var(--book-border);
    box-shadow: 0 18px 38px rgba(0, 0, 0, 0.38), inset 4px 0 12px rgba(255, 255, 255, 0.08);
    transform-origin: left center;
    transform: rotateY(0deg);
    backface-visibility: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 4;
    transition: transform 640ms var(--spring-book), opacity 420ms ease, background var(--color-trans);
  }
  .md3-book-cover::before {
    content: '';
    position: absolute;
    left: 14px;
    top: 0;
    bottom: 0;
    width: 1.5px;
    background: rgba(0, 0, 0, 0.28);
    box-shadow: 1px 0 0 rgba(255, 255, 255, 0.08);
  }
  .md3-book.open .md3-book-cover {
    transform: rotateY(-165deg);
    opacity: 0;
    pointer-events: none;
  }
  .md3-cover-monogram {
    font-size: 26px;
    font-weight: 900;
    letter-spacing: -1.2px;
    color: var(--book-emboss);
    text-shadow: 1px 1px 0 var(--book-emboss-hi);
    margin-left: 6px;
  }
  .md3-page-turner {
    position: absolute;
    top: 0;
    right: 0;
    width: 50%;
    height: 100%;
    background: var(--book-right-bg);
    border-radius: 0 28px 28px 0;
    transform-origin: left center;
    pointer-events: none;
    opacity: 0;
    z-index: 3;
  }
  @keyframes cleanPageTurn {
    0% { opacity: 0.95; transform: rotateY(0deg); }
    100% { opacity: 0; transform: rotateY(-170deg); }
  }
  .md3-page-turner.flipping {
    animation: cleanPageTurn 460ms var(--spring-book) forwards;
  }

  /* АЛЬБОМЫ */
  .albums-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  .album-card {
    background: var(--surface-container);
    border-radius: 28px;
    padding: 11px;
    border: 1px solid var(--outline-var);
  }
  .album-cover-box {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: 9px;
  }
  .book-spine {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 8px;
    background: rgba(0,0,0,0.22);
  }
  .album-title {
    font-size: 14px;
    font-weight: 800;
    color: var(--on-surface);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 0 4px;
  }
  .album-artist {
    font-size: 12px;
    color: var(--on-surface-var);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    padding: 2px 4px 0;
  }

  /* ТРЕКИ */
  .track-list { display: flex; flex-direction: column; gap: 8px; }
  .track-item {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--surface-container);
    padding: 9px 12px;
    border-radius: 22px;
    border: 1px solid var(--outline-var);
  }
  .track-item.playing {
    background: var(--secondary-container);
    color: var(--on-secondary-container);
  }
  .track-thumb { width: 44px; height: 44px; border-radius: 14px; flex-shrink: 0; }
  .track-info { flex: 1; min-width: 0; }
  .track-name { font-size: 14px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .track-sub { font-size: 12px; color: var(--on-surface-var); display: flex; align-items: center; gap: 6px; }
  .mini-action-btn {
    width: 38px;
    height: 38px;
    border-radius: 19px;
    border: none;
    background: transparent;
    color: var(--on-surface-var);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .mini-action-btn.active { color: var(--primary); }

  /* МИНИ-ПЛЕЕР */
  .mini-player {
    margin: 0 20px 8px;
    height: 64px;
    border-radius: 24px;
    background: var(--surface-high);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    z-index: 6;
    touch-action: none;
  }
  .mini-player-inner { flex: 1; display: flex; align-items: center; padding: 0 14px; gap: 12px; }
  .mini-progress-track { width: 100%; height: 3px; background: var(--surface-highest); }
  .mini-progress-fill { height: 100%; width: 22%; background: var(--primary); }

  /* НАВИГАЦИЯ */
  .bottom-nav {
    position: relative;
    margin: 0 20px 14px;
    height: 64px;
    border-radius: 32px;
    background: var(--surface-high);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: center;
    padding: 6px;
    z-index: 6;
  }
  .nav-pill-bg {
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 6px;
    width: calc((100% - 12px) / 3);
    border-radius: 26px;
    background: var(--primary-container);
    pointer-events: none;
    z-index: 0;
    transform: translate3d(calc(var(--nav-idx, 0) * 100%), 0, 0);
    transition: transform 440ms var(--spring-rubber), background var(--color-trans);
  }
  .nav-item {
    width: 100%;
    height: 100%;
    border: none;
    background: transparent;
    color: var(--on-surface-var);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 26px;
    z-index: 1;
    transition: color 220ms ease;
  }
  .nav-item.active { color: var(--on-primary-container); }

  /* ПОЛНЫЙ ПЛЕЕР СО SQUIGGLY CANVAS */
  .full-player {
    position: absolute;
    inset: 0;
    background: var(--bg);
    color: var(--on-surface);
    z-index: 30;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 16px 24px 26px;
    transform: translate3d(0, 105%, 0);
    transition: transform 540ms var(--spring-swipe);
    touch-action: none;
  }
  .full-player.open { transform: translate3d(0, 0, 0); }
  .fp-book-stage { position: relative; width: 100%; height: 244px; display: flex; align-items: center; justify-content: center; }
  .fp-spread-card {
    width: 100%;
    height: 216px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-radius: 28px;
    overflow: hidden;
    border: 1px solid var(--book-border);
    box-shadow: 0 20px 44px rgba(0, 0, 0, 0.36);
  }
  .squiggly-player-wrap { width: 100%; padding: 6px 0 2px; cursor: pointer; touch-action: none; }
  .squiggly-canvas { width: 100%; height: 38px; display: block; }
  .md3-play-fab {
    width: 76px;
    height: 76px;
    border-radius: 26px;
    border: none;
    background: var(--primary);
    color: var(--on-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.28);
  }

  /* ПЕРЕКЛЮЧАТЕЛИ И СЛАЙДЕРЫ */
  .capsule-toggle {
    position: relative;
    width: 60px;
    height: 34px;
    border-radius: 999px;
    background: var(--surface-highest);
    border: 1px solid var(--outline-var);
    padding: 4px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    transition: background 240ms ease;
  }
  .capsule-toggle.checked { background: var(--primary); }
  .capsule-toggle-knob {
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background: var(--on-surface-var);
    transition: transform 380ms var(--spring-rubber), background 240ms ease;
  }
  .capsule-toggle.checked .capsule-toggle-knob {
    transform: translateX(26px);
    background: var(--on-primary);
  }
  .profile-card {
    background: var(--surface-container);
    border: 1px solid var(--outline-var);
    border-radius: 30px;
    padding: 18px;
    margin-bottom: 14px;
  }
  .chip-pill {
    border: 1px solid var(--outline-var);
    padding: 9px 16px;
    border-radius: 20px;
    background: var(--surface-high);
    color: var(--on-surface-var);
    font-weight: 700;
    font-size: 13px;
    cursor: pointer;
  }
  .chip-pill.active { background: var(--primary); color: var(--on-primary); }
</style>
</head>
<body>
<div class="device-frame" id="appRoot">
  <!-- ВЕРХНИЙ БАР -->
  <header class="top-bar">
    <div class="brand-row" id="brandRow"><span class="brand-title">mmusic</span></div>
    <div class="top-actions">
      <button class="icon-btn rubber-btn" onclick="toggleSearch(true)"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></button>
      <button class="icon-btn rubber-btn" onclick="openAuthModal()"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></button>
    </div>
  </header>

  <!-- ВКЛАДКИ -->
  <main class="screens-viewport">
    <!-- 1. ПОТОК / КНИГА -->
    <section class="tab-screen active" id="screen-home">
      <div class="md3-book-stage" id="md3BookStage">
        <div class="md3-book" id="md3Book" onclick="toggleBookOpenAndPlay()">
          <div class="md3-book-spread">
            <div class="md3-page-left">
