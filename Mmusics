<!DOCTYPE html>
<html lang="ru" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>mmusic — Material You 3</title>
<link href="https://fonts.googleapis.com/css2?family=Roboto+Flex:opsz,wght@8..144,400;8..144,500;8..144,600;8..144,700;8..144,800;8..144,900&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,300..700,0..1,0" rel="stylesheet">
<style>
  :root {
    --seed-h: 14;
    --seed-s: 80%;
    --md-background: #0e0d11;
    --md-surface: #141318;
    --md-surface-dim: #111015;
    --md-surface-container-lowest: #09080c;
    --md-surface-container-low: #19171d;
    --md-surface-container: #201e25;
    --md-surface-container-high: #2a2831;
    --md-surface-container-highest: #35323d;
    --md-primary: hsl(var(--seed-h), var(--seed-s), 72%);
    --md-on-primary: hsl(var(--seed-h), var(--seed-s), 14%);
    --md-primary-container: hsl(var(--seed-h), calc(var(--seed-s) * 0.72), 26%);
    --md-on-primary-container: hsl(var(--seed-h), var(--seed-s), 92%);
    --md-secondary-container: hsl(calc(var(--seed-h) + 18), 32%, 25%);
    --md-on-secondary-container: hsl(calc(var(--seed-h) + 18), 65%, 90%);
    --md-tertiary-container: hsl(calc(var(--seed-h) + 45), 40%, 24%);
    --md-on-surface: #f4eff6;
    --md-on-surface-variant: #cac4d0;
    --md-outline: #938f99;
    --md-outline-variant: rgba(255, 255, 255, 0.09);
    --hero-bg-tint: hsl(var(--seed-h), 32%, 16%);
    --md-spring: cubic-bezier(0.2, 0, 0, 1);
  }
  [data-amoled="true"] {
    --md-background: #000000;
    --md-surface: #050507;
    --md-surface-container-lowest: #000000;
    --md-surface-container-low: #0d0d10;
    --md-surface-container: #141418;
    --md-surface-container-high: #1e1e24;
    --md-surface-container-highest: #282830;
    --hero-bg-tint: #120f12;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
  html, body {
    height: 100dvh;
    background-color: var(--md-background);
    color: var(--md-on-surface);
    font-family: 'Roboto Flex', sans-serif;
    overflow: hidden;
    user-select: none;
  }
  body { display: flex; flex-direction: column; }
  .icon {
    font-family: 'Material Symbols Rounded';
    font-size: 24px;
    font-variation-settings: 'FILL' 0, 'wght' 450, 'GRAD' 0, 'opsz' 24;
    display: inline-flex; align-items: center; justify-content: center; line-height: 1;
    transition: font-variation-settings 0.25s var(--md-spring), transform 0.25s var(--md-spring);
  }
  .icon.filled { font-variation-settings: 'FILL' 1, 'wght' 600, 'GRAD' 0, 'opsz' 24; }

  /* Тост-уведомление MD3 */
  .app-notice-toast {
    position: fixed; top: max(14px, env(safe-area-inset-top)); left: 16px; right: 16px; max-width: 420px; margin: 0 auto;
    background: var(--md-surface-container-highest); border: 1px solid var(--md-outline-variant);
    border-radius: 20px; padding: 12px 16px; z-index: 500;
    display: none; align-items: center; gap: 12px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.6); font-size: 13px; line-height: 1.4;
  }
  .app-notice-toast.show { display: flex; }

  main {
    flex: 1; overflow-y: auto;
    padding-bottom: calc(170px + env(safe-area-inset-bottom));
    max-width: 480px; width: 100%; margin: 0 auto; scrollbar-width: none;
  }
  main::-webkit-scrollbar { display: none; }
  .screen { display: none; animation: mdFadeIn 0.24s var(--md-spring); }
  .screen.active { display: block; }
  @keyframes mdFadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Верхняя секция Поток (MD3 Expressive) */
  .potok-top-section {
    position: relative; overflow: hidden;
    padding: max(20px, env(safe-area-inset-top)) 18px 20px;
    background: linear-gradient(180deg, var(--hero-bg-tint) 0%, var(--md-background) 100%);
    transition: background 0.4s ease;
  }
  .potok-bg-ribbon { position: absolute; right: -30px; top: 15px; width: 340px; height: 290px; pointer-events: none; opacity: 0.14; }
  .potok-header-bar { position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
  .potok-giant-title { font-size: 44px; font-weight: 900; line-height: 0.96; letter-spacing: -1.2px; color: var(--md-on-surface); }
  .md3-top-actions { display: flex; align-items: center; gap: 8px; }
  .top-bell-btn {
    width: 44px; height: 44px; border-radius: 22px; border: 1px solid var(--md-outline-variant);
    background: var(--md-surface-container-low); color: var(--md-on-surface);
    cursor: pointer; display: flex; align-items: center; justify-content: center;
    transition: background 0.2s, transform 0.15s;
  }
  .top-bell-btn:active { transform: scale(0.93); background: var(--md-surface-container-high); }

  .potok-collage-stage { position: relative; z-index: 2; height: 215px; margin-bottom: 12px; }
  .hero-cover-main, .hero-cover-top-right, .hero-cover-mid-right, .shortcut-thumb, .clean-track-cover, .stack-main-img, .stack-side-img, .fp-artwork {
    background: var(--md-surface-container-high);
  }
  .hero-cover-main { position: absolute; left: 0; top: 14px; width: 156px; height: 156px; border-radius: 32px; object-fit: cover; box-shadow: 0 16px 36px rgba(0, 0, 0, 0.55); border: 1px solid var(--md-outline-variant); }
  .hero-cover-top-right { position: absolute; right: 16px; top: 0; width: 88px; height: 88px; border-radius: 24px; object-fit: cover; box-shadow: 0 12px 28px rgba(0, 0, 0, 0.5); }
  .hero-cover-mid-right { position: absolute; right: 68px; top: 100px; width: 82px; height: 82px; border-radius: 22px; object-fit: cover; box-shadow: 0 12px 28px rgba(0, 0, 0, 0.5); }

  .potok-controls-row { position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; padding: 0 4px; margin-bottom: 18px; }
  .potok-mode-label {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--md-surface-container-high); color: var(--md-on-surface);
    padding: 10px 16px; border-radius: 999px; font-size: 13px; font-weight: 600;
    cursor: pointer; border: 1px solid var(--md-outline-variant);
  }
  .potok-white-play-btn {
    width: 78px; height: 78px; border-radius: 28px; border: none;
    background: var(--md-primary); color: var(--md-on-primary);
    display: flex; align-items: center; justify-content: center; cursor: pointer;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5); transition: border-radius 0.25s var(--md-spring), transform 0.15s;
  }
  .potok-white-play-btn:active { transform: scale(0.94); border-radius: 38px; }

  /* ФИРМЕННАЯ ЛИСТАЮЩАЯ КНИГА (MD3 3D FlipBook) */
  .flipbook-section { padding: 0 16px; margin-bottom: 26px; }
  .flipbook-header {
    display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;
  }
  .flipbook-badge {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 5px 12px; border-radius: 999px;
    background: var(--md-primary-container); color: var(--md-on-primary-container);
    font-size: 12px; font-weight: 700;
  }
  .book-svg-anim {
    width: 20px; height: 20px;
  }
  .book-svg-anim .page-flip {
    transform-origin: 12px 12px;
    animation: svgBookFlip 2.4s ease-in-out infinite;
  }
  @keyframes svgBookFlip {
    0%, 100% { transform: scaleX(1) skewY(0deg); opacity: 1; }
    50% { transform: scaleX(-0.85) skewY(-8deg); opacity: 0.75; }
  }
  .flipbook-stage {
    perspective: 1400px;
    width: 100%; height: 210px; position: relative;
  }
  .flipbook-card {
    width: 100%; height: 100%;
    background: linear-gradient(135deg, var(--md-surface-container-high) 0%, var(--md-surface-container) 100%);
    border: 1px solid var(--md-outline-variant);
    border-radius: 28px; display: grid; grid-template-columns: 1fr 1fr;
    overflow: hidden; position: relative;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.5);
  }
  /* Центральный корешок книги */
  .flipbook-spine {
    position: absolute; left: 50%; top: 10px; bottom: 10px; width: 2px;
    background: linear-gradient(180deg, transparent, rgba(255,255,255,0.22), transparent);
    transform: translateX(-50%); z-index: 6; pointer-events: none;
  }
  .flipbook-left-page, .flipbook-right-page {
    padding: 16px; display: flex; flex-direction: column; justify-content: space-between; position: relative;
  }
  .flipbook-left-page {
    background: radial-gradient(circle at top left, color-mix(in srgb, var(--md-primary-container) 45%, transparent), transparent 70%);
  }
  .flipbook-cover-wrap {
    position: relative; width: 104px; height: 104px; border-radius: 20px; overflow: hidden;
    box-shadow: 0 10px 24px rgba(0,0,0,0.45); border: 1px solid var(--md-outline-variant);
  }
  .flipbook-cover-wrap img { width: 100%; height: 100%; object-fit: cover; }
  .flipbook-page-num {
    font-size: 11px; font-weight: 700; color: var(--md-on-surface-variant);
    display: flex; align-items: center; gap: 4px;
  }
  .flipbook-story-tag {
    display: inline-flex; align-items: center; gap: 4px;
    font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--md-primary); margin-bottom: 4px;
  }
  .flipbook-track-title {
    font-size: 16px; font-weight: 800; color: var(--md-on-surface);
    line-height: 1.2; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .flipbook-track-artist { font-size: 12px; color: var(--md-on-surface-variant); margin-top: 3px; }
  .flipbook-quote {
    font-size: 11px; color: var(--md-on-surface-variant); line-height: 1.35;
    background: rgba(255,255,255,0.04); padding: 7px 9px; border-radius: 12px;
    border-left: 2px solid var(--md-primary); margin-top: 6px;
  }
  .flipbook-actions {
    display: flex; align-items: center; justify-content: space-between; gap: 6px; margin-top: 6px;
  }
  .flip-nav-btn {
    width: 34px; height: 34px; border-radius: 12px; border: 1px solid var(--md-outline-variant);
    background: var(--md-surface-container-highest); color: var(--md-on-surface);
    display: inline-flex; align-items: center; justify-content: center; cursor: pointer;
    transition: transform 0.15s, background 0.2s;
  }
  .flip-nav-btn:active { transform: scale(0.9); }
  .flip-play-chip {
    flex: 1; height: 34px; border-radius: 12px; border: none;
    background: var(--md-primary); color: var(--md-on-primary);
    font-size: 12px; font-weight: 800; display: inline-flex; align-items: center; justify-content: center; gap: 4px;
    cursor: pointer;
  }
  /* 3D анимированный лист при перелистывании */
  .flipbook-turning-leaf {
    position: absolute; top: 0; right: 0; width: 50%; height: 100%;
    background: linear-gradient(135deg, var(--md-surface-container-highest), var(--md-surface-container));
    border-left: 1px solid rgba(255,255,255,0.18);
    transform-origin: left center;
    pointer-events: none; opacity: 0; z-index: 10;
    border-radius: 0 28px 28px 0;
  }
  .flipbook-turning-leaf.turn-next {
    animation: pageTurnNext 0.55s cubic-bezier(0.32, 0.08, 0.24, 1);
  }
  .flipbook-turning-leaf.turn-prev {
    animation: pageTurnPrev 0.55s cubic-bezier(0.32, 0.08, 0.24, 1);
  }
  @keyframes pageTurnNext {
    0% { opacity: 0.95; transform: rotateY(0deg); }
    50% { opacity: 0.95; box-shadow: -18px 0 30px rgba(0,0,0,0.6); }
    100% { opacity: 0; transform: rotateY(-180deg); }
  }
  @keyframes pageTurnPrev {
    0% { opacity: 0.95; transform: rotateY(-180deg); }
    50% { opacity: 0.95; box-shadow: -18px 0 30px rgba(0,0,0,0.6); }
    100% { opacity: 0; transform: rotateY(0deg); }
  }

  /* Быстрые карточки MD3 */
  .dual-shortcut-row { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; padding: 0 16px; margin-bottom: 24px; }
  .shortcut-pill-card {
    display: flex; align-items: center; gap: 10px; height: 62px; padding: 6px 12px 6px 6px; border-radius: 20px;
    background: var(--md-surface-container); border: 1px solid var(--md-outline-variant); cursor: pointer;
    transition: transform 0.15s, background 0.2s;
  }
  .shortcut-pill-card:active { transform: scale(0.97); background: var(--md-surface-container-high); }
  .shortcut-thumb { width: 50px; height: 50px; border-radius: 14px; object-fit: cover; flex-shrink: 0; }
  .shortcut-info { min-width: 0; flex: 1; }
  .shortcut-title { font-size: 14px; font-weight: 700; color: var(--md-on-surface); display: flex; align-items: center; gap: 5px; }
  .shortcut-sub { font-size: 12px; color: var(--md-on-surface-variant); margin-top: 2px; }

  .home-section-title { font-size: 21px; font-weight: 800; letter-spacing: -0.3px; padding: 0 16px; margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between; }
  .for-you-scroll { display: flex; gap: 14px; overflow-x: auto; padding: 0 16px 8px; margin-bottom: 24px; scrollbar-width: none; }
  .for-you-scroll::-webkit-scrollbar { display: none; }
  .for-you-card { width: 172px; flex-shrink: 0; cursor: pointer; }
  .for-you-art-stack { position: relative; width: 172px; height: 160px; margin-bottom: 10px; display: flex; align-items: center; justify-content: center; }
  .stack-side-img { position: absolute; width: 124px; height: 124px; border-radius: 22px; object-fit: cover; opacity: 0.55; }
  .stack-side-img.left { left: 0; transform: rotate(-6deg) scale(0.92); }
  .stack-side-img.right { right: 0; transform: rotate(6deg) scale(0.92); }
  .stack-main-img { position: relative; z-index: 2; width: 144px; height: 144px; border-radius: 26px; object-fit: cover; box-shadow: 0 12px 28px rgba(0, 0, 0, 0.55); }
  .for-you-title { font-size: 14px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .for-you-sub { font-size: 12px; color: var(--md-on-surface-variant); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .library-screen-pad, .profile-screen-pad { padding: max(18px, env(safe-area-inset-top)) 16px 20px; }
  .lib-top-cards { display: flex; gap: 12px; overflow-x: auto; margin-bottom: 18px; scrollbar-width: none; }
  .lib-big-card { height: 124px; border-radius: 28px; padding: 18px; display: flex; flex-direction: column; justify-content: space-between; cursor: pointer; flex-shrink: 0; }
  .lib-big-card.red-fav {
    width: 260px; background: linear-gradient(135deg, var(--md-primary) 0%, var(--md-primary-container) 100%); color: var(--md-on-primary);
  }
  .lib-big-card.grey-dl {
    width: 164px; background: var(--md-surface-container-high); color: var(--md-on-surface); border: 1px solid var(--md-outline-variant);
  }
  .lib-filter-bar { display: flex; align-items: center; gap: 8px; overflow-x: auto; margin-bottom: 20px; scrollbar-width: none; }
  .lib-circle-btn, .fav-glass-btn {
    width: 44px; height: 44px; border-radius: 22px; border: 1px solid var(--md-outline-variant);
    background: var(--md-surface-container); color: var(--md-on-surface);
    display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; cursor: pointer;
  }
  .lib-pill-btn {
    height: 40px; padding: 0 18px; border-radius: 12px; border: 1px solid var(--md-outline-variant);
    background: var(--md-surface-container-low); color: var(--md-on-surface);
    font-size: 14px; font-weight: 600; white-space: nowrap; cursor: pointer; font-family: inherit;
    transition: all 0.2s var(--md-spring);
  }
  .lib-pill-btn.active { background: var(--md-secondary-container); color: var(--md-on-secondary-container); border-color: transparent; border-radius: 20px; }

  .clean-track-list { display: flex; flex-direction: column; gap: 6px; padding: 0 16px; }
  .clean-track-row {
    display: flex; align-items: center; padding: 8px 8px; border-radius: 18px; cursor: pointer;
    transition: background 0.2s;
  }
  .clean-track-row:active { background: var(--md-surface-container); }
  .clean-track-row.playing { background: var(--md-secondary-container); }
  .clean-track-cover { width: 52px; height: 52px; border-radius: 14px; object-fit: cover; flex-shrink: 0; }
  .clean-track-info { flex: 1; min-width: 0; margin: 0 12px; }
  .clean-track-title { font-size: 15px; font-weight: 700; color: var(--md-on-surface); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .clean-track-artist { font-size: 13px; color: var(--md-on-surface-variant); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .clean-dur-pill {
    padding: 5px 11px; border-radius: 999px; background: var(--md-surface-container-high);
    border: 1px solid var(--md-outline-variant); font-size: 12px; font-weight: 600; color: var(--md-on-surface-variant); flex-shrink: 0;
  }

  .search-screen-wrap { padding: max(18px, env(safe-area-inset-top)) 16px 20px; display: flex; flex-direction: column; min-height: calc(100dvh - 150px); justify-content: space-between; }
  .search-bottom-card, .profile-top-card, .profile-menu-group, .stats-top-summary, .stats-detail-box {
    background: var(--md-surface-container-low); border: 1px solid var(--md-outline-variant); border-radius: 28px;
  }
  .search-bottom-card { padding: 8px 0; margin-top: 14px; box-shadow: 0 14px 40px rgba(0, 0, 0, 0.5); }
  .history-item-row { display: flex; align-items: center; justify-content: space-between; padding: 12px 18px; cursor: pointer; }
  .history-left { display: flex; align-items: center; gap: 14px; font-size: 15px; font-weight: 500; color: var(--md-on-surface); }
  .history-left .icon { color: var(--md-on-surface-variant); font-size: 20px; }
  .search-card-input-bar { display: flex; align-items: center; gap: 12px; padding: 10px 14px 6px 18px; border-top: 1px solid var(--md-outline-variant); }
  .search-card-input-bar input, .auth-input-box input { flex: 1; background: transparent; border: none; color: var(--md-on-surface); font-size: 15px; font-family: inherit; outline: none; }
  .search-source-badge {
    width: 36px; height: 36px; border-radius: 18px; background: var(--md-primary-container); color: var(--md-primary); display: flex; align-items: center; justify-content: center;
  }

  .profile-top-card { padding: 18px; margin-bottom: 18px; }
  .profile-user-row { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; }
  .user-id-meta-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-bottom: 14px; }
  .user-id-chip { background: var(--md-surface-container); border: 1px solid var(--md-outline-variant); border-radius: 18px; padding: 10px 12px; }
  .user-id-chip-lbl { font-size: 11px; color: var(--md-on-surface-variant); margin-bottom: 3px; }
  .user-id-chip-val { font-size: 13px; font-weight: 800; color: var(--md-on-surface); word-break: break-all; }
  .profile-share-btn, .btn-white-pill {
    width: 100%; height: 48px; border-radius: 999px; border: none;
    background: var(--md-primary); color: var(--md-on-primary);
    font-size: 15px; font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 8px; cursor: pointer;
    font-family: inherit; transition: transform 0.15s, filter 0.2s;
  }
  .profile-share-btn:active, .btn-white-pill:active { transform: scale(0.98); }

  .profile-group-label { font-size: 13px; font-weight: 700; color: var(--md-primary); margin: 8px 8px 8px; letter-spacing: 0.02em; }
  .profile-menu-item { display: flex; align-items: center; justify-content: space-between; padding: 15px 18px; cursor: pointer; border-bottom: 1px solid var(--md-outline-variant); }
  .profile-menu-item:last-child { border-bottom: none; }
  .pm-left { display: flex; align-items: center; gap: 14px; font-size: 15px; font-weight: 600; color: var(--md-on-surface); }
  .pm-left .icon { color: var(--md-on-surface-variant); font-size: 21px; }
  .pm-right { display: flex; align-items: center; gap: 6px; color: var(--md-on-surface-variant); font-size: 14px; }

  /* Переключатель MD3 */
  .m3-switch { width: 52px; height: 30px; border-radius: 15px; background: var(--md-surface-container-highest); border: 2px solid var(--md-outline); position: relative; cursor: pointer; transition: all 0.22s var(--md-spring); }
  .m3-switch.on { background: var(--md-primary); border-color: var(--md-primary); }
  .m3-switch::after { content: ''; position: absolute; top: 5px; left: 5px; width: 16px; height: 16px; border-radius: 50%; background: var(--md-outline); transition: all 0.22s var(--md-spring); }
  .m3-switch.on::after { transform: translateX(22px) scale(1.25); background: var(--md-on-primary); }

  /* Карточка авторизации по логину и паролю (D1 / Cloudflare Worker) */
  .auth-card-md3 {
    background: var(--md-surface-container-low); border: 1px solid var(--md-outline-variant);
    border-radius: 28px; padding: 18px; margin-bottom: 18px;
  }
  .md3-segmented {
    display: grid; grid-template-columns: 1fr 1fr; background: var(--md-surface-container-high);
    padding: 4px; border-radius: 999px; margin-bottom: 14px; border: 1px solid var(--md-outline-variant);
  }
  .md3-seg-btn {
    height: 36px; border: none; border-radius: 999px; background: transparent;
    color: var(--md-on-surface-variant); font-weight: 700; font-size: 13px; cursor: pointer; font-family: inherit;
    transition: all 0.2s var(--md-spring);
  }
  .md3-seg-btn.active { background: var(--md-secondary-container); color: var(--md-on-secondary-container); }
  .auth-input-box {
    width: 100%; height: 50px; border-radius: 16px; background: var(--md-surface-container);
    border: 1px solid var(--md-outline-variant); display: flex; align-items: center; padding: 0 14px; gap: 10px; margin-bottom: 10px;
  }
  .auth-input-box:focus-within { border-color: var(--md-primary); }
  .auth-error-banner {
    display: none; padding: 10px 14px; border-radius: 14px; margin-bottom: 10px;
    background: rgba(255, 82, 82, 0.14); color: #ff8a80; font-size: 12px; font-weight: 600;
  }
  .auth-error-banner.show { display: block; }

  /* Мини-плеер MD3 */
  .mini-player {
    position: fixed; left: 12px; right: 12px; bottom: calc(82px + env(safe-area-inset-bottom)); max-width: 456px; margin: 0 auto;
    background: color-mix(in srgb, var(--md-surface-container-high) 92%, var(--md-primary) 8%);
    backdrop-filter: blur(20px);
    border-radius: 24px; box-shadow: 0 12px 32px rgba(0, 0, 0, 0.55); overflow: hidden; z-index: 35;
    border: 1px solid var(--md-outline-variant); transition: transform 0.25s var(--md-spring), opacity 0.2s;
  }
  .mini-player.hidden { transform: translateY(160%); opacity: 0; pointer-events: none; }
  .mini-body { display: flex; align-items: center; padding: 8px 12px; cursor: pointer; }
  .mini-play-btn {
    width: 42px; height: 42px; border-radius: 14px; border: none;
    background: var(--md-primary); color: var(--md-on-primary);
    display: inline-flex; align-items: center; justify-content: center; cursor: pointer; margin-right: 4px;
  }
  .mini-progress-track { height: 3px; background: rgba(255, 255, 255, 0.08); width: 100%; }
  .mini-progress-fill { height: 100%; background: var(--md-primary); width: 0%; transition: width 0.25s linear; }

  /* Полноэкранный плеер */
  .full-player {
    position: fixed; inset: 0;
    background: radial-gradient(circle at top, color-mix(in srgb, var(--md-primary-container) 60%, transparent) 0%, transparent 38%), var(--md-background);
    z-index: 80; display: flex; flex-direction: column;
    padding: max(16px, env(safe-area-inset-top)) 22px calc(28px + env(safe-area-inset-bottom));
    transform: translateY(104%); transition: transform 0.34s var(--md-spring);
  }
  .full-player.expanded { transform: translateY(0); }
  .fp-container { max-width: 440px; width: 100%; height: 100%; margin: 0 auto; display: flex; flex-direction: column; justify-content: space-between; }
  .fp-media-stage {
    position: relative; width: 100%; max-width: 312px; aspect-ratio: 1/1; margin: 6px auto; border-radius: 36px; overflow: hidden;
    box-shadow: 0 20px 48px rgba(0,0,0,0.6); background: var(--md-surface-container-low);
  }
  .fp-artwork { width: 100%; height: 100%; object-fit: cover; display: block; }
  #ytPlayerMount { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; left: -9999px; top: -9999px; }
  .fp-controls { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .ctrl-secondary { width: 58px; height: 58px; border-radius: 29px; border: none; background: var(--md-surface-container-high); color: var(--md-on-surface); display: flex; align-items: center; justify-content: center; cursor: pointer; }
  .ctrl-primary-play { width: 88px; height: 70px; border-radius: 26px; border: none; background: var(--md-primary); color: var(--md-on-primary); display: flex; align-items: center; justify-content: center; cursor: pointer; }

  /* НИЖНЯЯ ПАНЕЛЬ НАВИГАЦИИ MD3 (БЕЗ ПОДПИСЕЙ, БОЛЬШЕ ИКОНОК + ФИРМЕННАЯ КНИГА) */
  .bottom-nav-pill {
    position: fixed; left: 12px; right: 12px; bottom: max(10px, env(safe-area-inset-bottom));
    height: 66px; max-width: 460px; margin: 0 auto;
    background: color-mix(in srgb, var(--md-surface-container) 90%, var(--md-primary-container) 10%);
    backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);
    border: 1px solid var(--md-outline-variant);
    border-radius: 34px; padding: 0 6px;
    display: flex; justify-content: space-between; align-items: center;
    z-index: 40; box-shadow: 0 12px 34px rgba(0, 0, 0, 0.6);
  }
  .nav-btn {
    background: none; border: none; color: var(--md-on-surface-variant);
    flex: 1; height: 100%; display: flex; align-items: center; justify-content: center;
    cursor: pointer; position: relative;
  }
  .nav-pill-indicator {
    width: 48px; height: 42px; border-radius: 21px;
    display: flex; align-items: center; justify-content: center;
    transition: all 0.28s var(--md-spring);
  }
  .nav-btn.active { color: var(--md-on-secondary-container); }
  .nav-btn.active .nav-pill-indicator {
    width: 56px;
    background: var(--md-secondary-container);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.08);
  }
  .nav-btn:active .nav-pill-indicator { transform: scale(0.9); }

  /* Центральная кнопка фирменной книги в доке MD3 */
  .nav-btn.book-special .nav-pill-indicator {
    background: color-mix(in srgb, var(--md-primary-container) 65%, transparent);
    color: var(--md-primary);
    border-radius: 18px;
  }
  .nav-btn.book-special.active .nav-pill-indicator {
    background: var(--md-primary);
    color: var(--md-on-primary);
    border-radius: 22px;
  }
</style>
</head>
