  </main>

  <!-- МИНИ-ПЛЕЕР -->
  <div class="mini-player glass-panel" id="miniPlayerBar" onclick="openFullPlayer()">
    <div class="mini-player-inner" id="miniPlayerInner">
      <div style="width:12px;height:12px;border-radius:6px;background:var(--primary);flex-shrink:0;"></div>
      <div class="track-info">
        <div class="track-name" id="miniTitle">Первый луч</div>
        <div class="track-sub" id="miniArtist">Aether Line</div>
      </div>
      <button class="mini-action-btn rubber-btn" onclick="event.stopPropagation(); togglePlay();">
        <svg id="miniPlayIcon" width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
      </button>
      <button class="mini-action-btn rubber-btn" onclick="event.stopPropagation(); nextTrack(1);">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="m6 18 8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg>
      </button>
